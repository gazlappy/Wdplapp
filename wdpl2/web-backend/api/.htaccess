# index.php is the only public entry point. Everything else under api/ -
# core/, modules/ and above all config.php - must never be fetchable directly,
# whether PHP executes or (on a misconfigured host) serves it as plain text.
#
# The deny list covers .html and .js as well as .php, because the previous
# backend left an admin dashboard at api/admin/index.html which stayed publicly
# readable: a rule that only denied .php let the page itself be fetched even
# though every endpoint behind it was refused.

Options -Indexes

<IfModule mod_authz_core.c>
    # Apache 2.4
    <FilesMatch "\.(php|sql|md|html|htm|js|json)$">
        Require all denied
    </FilesMatch>
    <Files "index.php">
        Require all granted
    </Files>
</IfModule>

<IfModule !mod_authz_core.c>
    # Apache 2.2 fallback
    <FilesMatch "\.(php|sql|md|html|htm|js|json)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <Files "index.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>

# config.php holds database credentials and the admin password hash. Deny it
# unconditionally, outside the rules above, so a single misconfiguration cannot
# expose it.
<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>
