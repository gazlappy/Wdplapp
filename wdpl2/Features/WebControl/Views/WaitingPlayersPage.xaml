<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebControl.WaitingPlayersPage"
             Title="Players waiting">

    <ScrollView BackgroundColor="#F8FAFC">
        <VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="900" HorizontalOptions="Start">

            <Label Text="Players waiting" FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
            <Label Text="Captains can add someone who turns up on the night. They stay on the website until you take them in here — publishing the season does not remove them, and does not bring them across either."
                   FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap"/>

            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label x:Name="CountLabel" Text="Checking the website…" FontAttributes="Bold"
                               FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                        <Button Grid.Column="1" x:Name="RefreshButton" Text="Check again"
                                Clicked="OnRefreshClicked"
                                BackgroundColor="#334155" TextColor="White" CornerRadius="8"
                                FontSize="12" Padding="12,6"/>
                    </Grid>

                    <VerticalStackLayout x:Name="WaitingList" Spacing="6"/>

                    <Label x:Name="EmptyLabel" IsVisible="False"
                           Text="Nobody is waiting. Anything a captain adds from now on will show up here."
                           FontSize="11" TextColor="#94A3B8"/>

                    <Button x:Name="CollectButton" Text="Take them into the app" Clicked="OnCollectClicked"
                            BackgroundColor="#059669" TextColor="White" CornerRadius="8"
                            FontSize="13" IsEnabled="False" Margin="0,4,0,0"/>

                    <Label Text="You are asked about each one: link it to somebody the app already has, or add it as a new player."
                           FontSize="11" TextColor="#94A3B8"/>
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="StatusLabel" FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap" Margin="4,0,0,16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
