<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebControl.CaptainsPage"
             Title="Captains">

    <ScrollView BackgroundColor="#F8FAFC">
        <VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="900" HorizontalOptions="Start">

            <Label Text="Captains" FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
            <Label Text="Set each team's PIN, then publish so captains can sign in on the website."
                   FontSize="12" TextColor="#64748B"/>

            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Season" FontAttributes="Bold" FontSize="13" TextColor="#475569"/>
                    <Picker x:Name="SeasonPicker" FontSize="13" SelectedIndexChanged="OnSeasonChanged"/>
                    <Label x:Name="SummaryLabel" FontSize="11" TextColor="#94A3B8"/>
                    <Label x:Name="WeakLabel" FontSize="11" TextColor="#D97706" IsVisible="False" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- PIN editor -->
            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Team PINs" FontAttributes="Bold" FontSize="13" TextColor="#475569"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1" x:Name="FillButton" Text="Fill blanks" Clicked="OnFillBlanksClicked"
                                BackgroundColor="#334155" TextColor="White" CornerRadius="8"
                                FontSize="12" Padding="12,6"/>
                        <Button Grid.Column="2" x:Name="SaveButton" Text="Save PINs" Clicked="OnSaveClicked"
                                BackgroundColor="#059669" TextColor="White" CornerRadius="8"
                                FontSize="12" Padding="12,6"/>
                    </Grid>

                    <Label Text="PINs are shown in full so you can pass them to captains. They are stored in your league data and hashed before being sent to the website."
                           FontSize="11" TextColor="#94A3B8"/>

                    <!-- Header row -->
                    <Grid ColumnDefinitions="2*,1.4*,Auto" ColumnSpacing="8" Padding="0,6,0,2">
                        <Label Text="TEAM" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8"/>
                        <Label Grid.Column="1" Text="PIN" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8"/>
                        <Label Grid.Column="2" Text=" " FontSize="10"/>
                    </Grid>

                    <VerticalStackLayout x:Name="TeamList" Spacing="2"/>
                    <Label x:Name="NoTeamsLabel" Text="No teams in this season." FontSize="11"
                           TextColor="#94A3B8" IsVisible="False"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Publish -->
            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Publish" FontAttributes="Bold" FontSize="13" TextColor="#475569"/>
                    <Label Text="Sends the hashed PINs to the website. The PIN itself never leaves this machine. Teams left blank cannot sign in."
                           FontSize="11" TextColor="#94A3B8"/>
                    <Button x:Name="PushButton" Text="Publish captain PINs" Clicked="OnPushClicked"
                            BackgroundColor="#2563EB" TextColor="White" CornerRadius="8"
                            FontSize="13" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Players captains added online -->
            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Players added by captains" FontAttributes="Bold" FontSize="13" TextColor="#475569"/>
                    <Label Text="Captains can add someone who turns up on the night. They stay on the website until you take them in here — publishing does not remove them."
                           FontSize="11" TextColor="#94A3B8"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="CheckAddedButton" Text="Check for new players" Clicked="OnCheckAddedClicked"
                                BackgroundColor="#334155" TextColor="White" CornerRadius="8" FontSize="13"/>
                        <Button x:Name="CollectButton" Grid.Column="1" Text="Add them to the app" Clicked="OnCollectClicked"
                                BackgroundColor="#059669" TextColor="White" CornerRadius="8" FontSize="13"
                                IsEnabled="False"/>
                    </Grid>
                    <Frame x:Name="AddedFrame" IsVisible="False" BorderColor="#E2E8F0" Padding="10"
                           CornerRadius="8" BackgroundColor="#F8FAFC" HasShadow="False">
                        <Label x:Name="AddedDetail" FontSize="11" TextColor="#475569" LineBreakMode="WordWrap"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Who can sign in" FontAttributes="Bold" FontSize="13" TextColor="#475569"/>
                    <Label Text="Captains can change their own PIN on the website. It is stored hashed, so it cannot be read back here — but this shows you which teams have changed one, so you know the PIN above is no longer the live one."
                           FontSize="11" TextColor="#94A3B8"/>
                    <Button x:Name="StatusButton" Text="Refresh from website" Clicked="OnStatusClicked"
                            BackgroundColor="#334155" TextColor="White" CornerRadius="8" FontSize="13"/>
                    <Frame x:Name="StatusFrame" IsVisible="False" BorderColor="#E2E8F0" Padding="10"
                           CornerRadius="8" BackgroundColor="#F8FAFC" HasShadow="False">
                        <Label x:Name="StatusDetail" FontSize="11" TextColor="#475569" LineBreakMode="WordWrap"/>
                    </Frame>
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="StatusLabel" FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap" Margin="4,0,0,16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
