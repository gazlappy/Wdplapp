<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebControl.MessagesPage"
             Title="Message centre">

    <ScrollView BackgroundColor="#F8FAFC">
        <VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="900" HorizontalOptions="Start">

            <Label Text="Message centre" FontSize="20" FontAttributes="Bold" TextColor="#1E293B"/>
            <Label Text="Every note captains have written on their scorecards. The app keeps its own copy of each one, so they stay here after the website has moved on - and if a captain changes a note, both versions are kept. New means not yet marked read, here or on the website's admin page."
                   FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap"/>

            <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label x:Name="CountLabel" Text="Checking the website…" FontAttributes="Bold"
                               FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                        <Button Grid.Column="1" x:Name="ReadAllButton" Text="Mark all read"
                                Clicked="OnReadAllClicked" IsVisible="False"
                                BackgroundColor="#2563EB" TextColor="White" CornerRadius="8"
                                FontSize="12" Padding="12,6"/>
                        <Button Grid.Column="2" x:Name="RefreshButton" Text="Check again"
                                Clicked="OnRefreshClicked"
                                BackgroundColor="#334155" TextColor="White" CornerRadius="8"
                                FontSize="12" Padding="12,6"/>
                    </Grid>

                    <FlexLayout Wrap="Wrap" AlignItems="Center">
                        <Entry x:Name="SearchEntry" Placeholder="Search team or words"
                               TextChanged="OnFilterChanged" WidthRequest="240" FontSize="13" Margin="0,0,10,6"/>
                        <Picker x:Name="SeasonPicker" Title="Season" WidthRequest="200" FontSize="13"
                                SelectedIndexChanged="OnFilterChanged" Margin="0,0,10,6"/>
                        <HorizontalStackLayout Spacing="4">
                            <CheckBox x:Name="NewOnlyBox" CheckedChanged="OnFilterChanged" VerticalOptions="Center"/>
                            <Label Text="New only" FontSize="12" TextColor="#475569" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <VerticalStackLayout x:Name="MessageList" Spacing="8"/>

                    <Label x:Name="EmptyLabel" IsVisible="False" FontSize="11" TextColor="#94A3B8"/>
                </VerticalStackLayout>
            </Frame>

            <Label x:Name="StatusLabel" FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap" Margin="4,0,0,16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
