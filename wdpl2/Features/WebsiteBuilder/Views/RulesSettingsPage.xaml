<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.RulesSettingsPage"
             Title="League Rules">

    <Grid ColumnDefinitions="280,Auto,*">

        <!-- LEFT: TOC Panel -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" BackgroundColor="#F8FAFC">

            <VerticalStackLayout Grid.Row="0" Padding="16,16,16,10" Spacing="4">
                <Label Text="&#128214; League Rules" FontSize="20" FontAttributes="Bold" TextColor="#3B82F6"/>
                <Label Text="Select a section to view" FontSize="12" TextColor="#9CA3AF"/>
            </VerticalStackLayout>

            <Frame Grid.Row="1" BorderColor="#E5E7EB" Padding="10" CornerRadius="6"
                   Margin="12,0,12,8" BackgroundColor="#F0FDF4">
                <Label Text="Rules page visibility is controlled in Pages and Content settings." FontSize="11" TextColor="#6B7280" LineBreakMode="WordWrap"/>
            </Frame>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout x:Name="TocPanel" Spacing="0" Padding="0,4,0,8"/>
            </ScrollView>

            <Button Grid.Row="3" x:Name="SaveBtn" Text="&#128190; Save Rules"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#10B981" TextColor="White" FontSize="13"
                    Padding="16,10" CornerRadius="6" Margin="12,8,12,12"/>
        </Grid>

        <!-- Separator -->
        <BoxView Grid.Column="1" WidthRequest="1" Color="#E2E8F0"/>

        <!-- RIGHT: Content Panel -->
        <ScrollView Grid.Column="2" x:Name="ContentScrollView">
            <VerticalStackLayout x:Name="ContentPanel" Padding="28,24" Spacing="12">

                <VerticalStackLayout x:Name="PlaceholderPanel" Spacing="8"
                                     VerticalOptions="CenterAndExpand" HorizontalOptions="Center"
                                     Padding="0,120,0,0">
                    <Label Text="&#128209;" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Select a rule section from the left panel"
                           FontSize="16" TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <Label x:Name="ContentCategory" FontSize="11" FontAttributes="Bold"
                       TextColor="#9CA3AF" IsVisible="False"/>
                <Label x:Name="ContentTitle" FontSize="22" FontAttributes="Bold"
                       TextColor="#1F2937" IsVisible="False"/>
                <BoxView x:Name="ContentDivider" HeightRequest="2" Color="#3B82F6"
                         HorizontalOptions="Start" WidthRequest="60" IsVisible="False"/>
                <Border x:Name="EditorFrame" Stroke="#E2E8F0" StrokeThickness="1"
                        Padding="12" IsVisible="False" BackgroundColor="White">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <Editor x:Name="ContentEditor" FontSize="14" TextColor="#374151"
                            AutoSize="TextChanges"
                            TextChanged="OnContentEditorChanged"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
