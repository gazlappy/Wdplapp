<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.EntryFormsSettingsPage"
             Title="Online Forms" BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0" SizeChanged="OnWorkspaceSizeChanged">

        <!-- Header -->
        <Grid Padding="24,20" RowDefinitions="Auto,Auto" RowSpacing="12" BackgroundColor="#0F172A">
            <VerticalStackLayout Spacing="5">
                <Label Text="WEBSITE BUILDER / REGISTRATIONS" FontSize="10" CharacterSpacing="1.5" TextColor="#93C5FD"/>
                <Label Text="Online forms" FontSize="28" FontAttributes="Bold" TextColor="White"/>
                <Label Text="Design a form. Preview the experience. Review every entry." FontSize="13" TextColor="#CBD5E1" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Spacing="10">
                <Label Text="Show forms on website" FontAttributes="Bold" FontSize="12" TextColor="#E2E8F0" VerticalOptions="Center"/>
                <Switch x:Name="ShowEntryFormsSwitch" Toggled="OnShowToggled" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="16,10" RowDefinitions="Auto,Auto" RowSpacing="8">
            <Label x:Name="WorkspaceSummaryLabel" FontSize="12" TextColor="#475569" LineBreakMode="WordWrap"/>
            <HorizontalStackLayout Grid.Row="1" x:Name="WorkspaceTabs" Spacing="8" IsVisible="False">
                <Button Text="Design form" Clicked="OnDesignTabClicked" BackgroundColor="#2563EB" TextColor="White" CornerRadius="10" Padding="16,8"/>
                <Button Text="Review entries" Clicked="OnRecordsTabClicked" BackgroundColor="#E2E8F0" TextColor="#0F172A" CornerRadius="10" Padding="16,8"/>
            </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="2" x:Name="WorkspaceGrid" ColumnDefinitions="*,Auto,*" ColumnSpacing="0">

            <!-- ═══════════════ LEFT: Forms ═══════════════ -->
            <Grid x:Name="DesignPane" RowDefinitions="Auto,Auto,*" RowSpacing="0" BackgroundColor="#F8FAFC">

                <!-- Add buttons -->
                <Grid Padding="16,10,16,8" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button x:Name="AddTeamEntryBtn" Text="+ Team"
                            Clicked="OnAddTeamEntryClicked" BackgroundColor="#10B981" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                    <Button Grid.Column="1" x:Name="AddCompEntryBtn" Text="+ Competition"
                            Clicked="OnAddCompEntryClicked" BackgroundColor="#8B5CF6" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                    <Button Grid.Column="2" x:Name="AddCustomBtn" Text="+ Custom"
                            Clicked="OnAddCustomClicked" BackgroundColor="#3B82F6" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                </Grid>

                <!-- Form list -->
                <CollectionView Grid.Row="1" x:Name="FormsCollection" HeightRequest="160"
                                SelectionMode="Single" SelectionChanged="OnFormSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="10" Margin="8,3" CornerRadius="8"
                                   BorderColor="#E2E8F0" BackgroundColor="White" HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <Frame Padding="4,2" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                                           BackgroundColor="{Binding TypeBadgeColor}">
                                        <Label Text="{Binding TypeLabel}" FontSize="10" TextColor="White"/>
                                    </Frame>
                                    <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold"
                                           FontSize="12" TextColor="#1E293B" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding FieldCountLabel}" FontSize="10" TextColor="#64748B" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding StatusIcon}" FontSize="11" TextColor="#475569" VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6" Padding="16">
                            <Label Text="&#128203;" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="No entry forms yet" FontSize="13" FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                            <Label Text="Use the buttons above to create one"
                                   FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Form editor (scrollable) -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Padding="16,8" Spacing="12">

                        <!-- Placeholder when nothing selected -->
                        <VerticalStackLayout x:Name="EditorPlaceholder" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                            <Label Text="&#9997;" FontSize="36" HorizontalOptions="Center" Margin="0,20,0,0"/>
                            <Label Text="Select a form to edit" FontSize="14" FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Editor form -->
                        <VerticalStackLayout x:Name="EditorForm" IsVisible="False" Spacing="12">
                            <Border Stroke="#BFDBFE" BackgroundColor="#EFF6FF" Padding="12" StrokeShape="RoundRectangle 12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Private editing draft" FontSize="13" FontAttributes="Bold" TextColor="#1E40AF"/>
                                    <Label Text="Changes stay here until Save. Preview never sends entries. Regenerate and publish your website to make saved changes live." FontSize="12" TextColor="#1E40AF" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Form Details -->
                            <Label Text="FORM DETAILS" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>

                            <Frame BorderColor="#E2E8F0" Padding="12" CornerRadius="10" BackgroundColor="White">
                                <VerticalStackLayout Spacing="10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Title" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                        <Entry x:Name="TitleEntry" Placeholder="e.g. Season 2025 Team Entry" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Description" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                        <Editor x:Name="DescriptionEditor" Placeholder="Instructions for people filling in the form..."
                                                AutoSize="TextChanges" FontSize="13" HeightRequest="60"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Submit Button Text" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                        <Entry x:Name="SubmitButtonEntry" Placeholder="Submit Entry" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="Message after confirmed online delivery" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                        <Editor x:Name="ConfirmationEditor" Placeholder="Thank you for your entry!" AutoSize="TextChanges" FontSize="13"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Logo -->
                            <Label Text="FORM LOGO" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>

                            <Frame BorderColor="#E2E8F0" Padding="12" CornerRadius="10" BackgroundColor="White">
                                <VerticalStackLayout Spacing="8">
                                    <Image x:Name="FormLogoPreview" HeightRequest="60" Aspect="AspectFit"
                                           HorizontalOptions="Center" IsVisible="False"/>
                                    <Label x:Name="NoLogoLabel" Text="No logo set" FontSize="11" TextColor="#94A3B8"
                                           HorizontalOptions="Center"/>
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Button x:Name="UploadFormLogoBtn" Text="&#128247; Upload Logo"
                                                Clicked="OnUploadFormLogoClicked"
                                                BackgroundColor="#3B82F6" TextColor="White" FontSize="11"
                                                Padding="10,7" CornerRadius="8"/>
                                        <Button x:Name="ClearFormLogoBtn" Text="Clear" IsVisible="False"
                                                Clicked="OnClearFormLogoClicked"
                                                BackgroundColor="Transparent" TextColor="#EF4444" FontSize="11"
                                                Padding="6,4"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Status -->
                            <Label Text="STATUS" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>

                            <Frame BorderColor="#E2E8F0" Padding="12" CornerRadius="10" BackgroundColor="White">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="Published (visible on website)" FontSize="12" TextColor="#475569" VerticalOptions="Center"/>
                                        <Switch Grid.Column="1" x:Name="IsPublishedSwitch"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="Closed (no new entries)" FontSize="12" TextColor="#475569" VerticalOptions="Center"/>
                                        <Switch Grid.Column="1" x:Name="IsClosedSwitch"/>
                                    </Grid>
                                    <VerticalStackLayout Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Set a closing date" FontSize="12" FontAttributes="Bold" TextColor="#475569" VerticalOptions="Center"/>
                                            <Switch Grid.Column="1" x:Name="HasClosingDateSwitch" Toggled="OnHasClosingDateToggled"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <DatePicker x:Name="ClosingDatePicker" FontSize="13"/>
                                            <Button Grid.Column="1" x:Name="ClearClosingDateBtn" Text="Clear" Clicked="OnClearClosingDate"
                                                    BackgroundColor="Transparent" TextColor="#EF4444" FontSize="11"
                                                    Padding="6,4" VerticalOptions="Center"/>
                                        </Grid>
                                        <Label Text="Entries remain open through this date. The receiving service must also enforce the deadline." FontSize="11" TextColor="#64748B" LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Fields -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="FORM FIELDS" FontSize="10" FontAttributes="Bold" TextColor="#94A3B8"
                                       CharacterSpacing="1.5" VerticalOptions="Center"/>
                                <Button Grid.Column="1" x:Name="AddFieldBtn" Text="+ Add Field" Clicked="OnAddFieldClicked"
                                        BackgroundColor="#3B82F6" TextColor="White" FontSize="11"
                                        Padding="10,7" CornerRadius="8"/>
                            </Grid>

                            <VerticalStackLayout x:Name="FieldsPanel" Spacing="6"/>

                            <VerticalStackLayout x:Name="NoFieldsLabel" IsVisible="False" Spacing="3" Padding="12">
                                <Label Text="No fields yet" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                <Label Text="Add fields to build your form" FontSize="11" TextColor="#CBD5E1" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- Bottom actions -->
                            <Label x:Name="FormValidationLabel" IsVisible="False" FontSize="12" TextColor="#B91C1C" LineBreakMode="WordWrap"/>
                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                <Button Text="Preview" Clicked="OnPreviewFormClicked" BackgroundColor="#EFF6FF" TextColor="#1D4ED8" CornerRadius="10" Padding="16,10" Margin="0,0,8,8"/>
                                <Button x:Name="SaveFormBtn" Text="&#128190; Save Form"
                                        Clicked="OnSaveFormClicked"
                                        BackgroundColor="#10B981" TextColor="White" FontSize="13"
                                        Padding="14,10" CornerRadius="8" Margin="0,0,8,8"/>
                                <Button Grid.Column="1" x:Name="DuplicateFormBtn" Text="&#128203; Duplicate" IsEnabled="False"
                                        Clicked="OnDuplicateFormClicked" BackgroundColor="#EFF6FF" TextColor="#3B82F6"
                                        FontSize="11" Padding="10,8" CornerRadius="8" Margin="0,0,8,8"/>
                                <Button Grid.Column="2" x:Name="DeleteFormBtn" Text="&#128465; Delete" IsEnabled="False"
                                        Clicked="OnDeleteFormClicked" BackgroundColor="#FEE2E2" TextColor="#DC2626"
                                        FontSize="11" Padding="10,8" CornerRadius="8"/>
                            </FlexLayout>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <!-- Divider -->
            <BoxView x:Name="WorkspaceDivider" Grid.Column="1" WidthRequest="1" BackgroundColor="#CBD5E1"/>

            <!-- ═══════════════ RIGHT: Records ═══════════════ -->
            <Grid x:Name="RecordsPane" Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="0">

                <!-- Form service settings (collapsible) -->
                <Frame Padding="10,8" Margin="10,6,10,0" CornerRadius="8" BorderColor="#E2E8F0" BackgroundColor="#F8FAFC" HasShadow="False">
                    <VerticalStackLayout Spacing="6">
                        <Button Text="Delivery and collection settings" Clicked="OnToggleServiceClicked" BackgroundColor="Transparent" TextColor="#1D4ED8" HorizontalOptions="Start" FontSize="12" Padding="4"/>
                        <Label x:Name="DeliveryStatusLabel" FontSize="12" TextColor="#475569" LineBreakMode="WordWrap"/>
                        <VerticalStackLayout x:Name="ServiceSettingsPanel" IsVisible="False" Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Use our own hosting" FontAttributes="Bold" FontSize="12" TextColor="#475569" VerticalOptions="Center"/>
                                <Switch x:Name="UseHostedFormsSwitch" Grid.Column="1" Toggled="OnHostedModeToggled"/>
                            </Grid>
                            <VerticalStackLayout x:Name="HostedServicePanel" IsVisible="False" Spacing="6">
                                <Label Text="Requires PHP, MySQL and HTTPS. Deploy the bundled backend using Web Inbox → Deploy backend. Save the API URL/admin login in Web Inbox settings. Credentials remain private."
                                       FontSize="11" TextColor="#475569" LineBreakMode="WordWrap"/>
                                <Label Text="Public Website URL" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                                <Entry x:Name="HostedWebsiteUrlEntry" Placeholder="HTTPS address visitors use to open the website" FontSize="12" Keyboard="Url"/>
                                <Label Text="Use the published website address, not the /api/ address. Match the actual hostname, including www if used. This also updates the shared Website URL setting."
                                       FontSize="11" TextColor="#475569" LineBreakMode="WordWrap"/>
                                <Button x:Name="SaveHostedSettingsBtn" Text="Save hosting settings" Clicked="OnSaveHostedSettingsClicked"
                                        BackgroundColor="#10B981" TextColor="White" FontSize="12" CornerRadius="8" HorizontalOptions="Start"/>
                                <Label Text="Publish sends only saved, published forms. It also closes omitted forms on the server, without deleting entries. Repeat after changing fields, closing dates or publication status. London time applies."
                                       FontSize="11" TextColor="#92400E" LineBreakMode="WordWrap"/>
                                <Button x:Name="PublishHostedFormsBtn" Text="Publish saved forms to our hosting" Clicked="OnPublishHostedFormsClicked"
                                        BackgroundColor="#2563EB" TextColor="White" FontSize="12" CornerRadius="8" HorizontalOptions="Start"/>
                                <Label Text="The hosting switch saves immediately. Save hosting settings to keep the website address locally; Publish also saves this address. Online delivery is enabled only after the backend acknowledges publishing. Then regenerate/deploy the website. Fetch Submissions uses the saved Web Inbox admin login and still requires review."
                                       FontSize="11" TextColor="#475569" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ExternalServicePanel" Spacing="6">
                            <Label Text="Public HTTPS POST endpoint (no secrets)" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                            <Entry x:Name="FormServiceUrlEntry" Placeholder="Optional public entry endpoint" FontSize="12" Keyboard="Url"/>
                            <Label Text="Private collection URL (GET / legacy JSONBin)" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                            <Entry x:Name="FormServiceFetchUrlEntry" Placeholder="Private URL for fetching entries" FontSize="12" Keyboard="Url"/>
                            <Label Text="Private token — used only by the app" FontSize="11" FontAttributes="Bold" TextColor="#475569"/>
                            <Entry x:Name="FormServiceTokenEntry" Placeholder="Bearer token or JSONBin X-Master-Key" FontSize="12" IsPassword="True"/>
                            <Label Text="Online delivery needs a compatible endpoint returning accepted: true and the entry id. See Docs/OnlineForms.md. Without one, visitors download and send entries manually. JSONBin master keys are never published. Rotate any key exposed by an older website." FontSize="11" TextColor="#92400E" LineBreakMode="WordWrap"/>
                        <HorizontalStackLayout Spacing="6">
                            <Button x:Name="SaveServiceBtn" Text="&#128190; Save" Clicked="OnSaveServiceSettingsClicked"
                                    BackgroundColor="#10B981" TextColor="White" FontSize="11" Padding="10,6" CornerRadius="6"/>
                            <Button x:Name="CreateBinBtn" Text="Create legacy bin" Clicked="OnCreateBinClicked"
                                    BackgroundColor="#3B82F6" TextColor="White" FontSize="11" Padding="10,6" CornerRadius="6"
                                    ToolTipProperties.Text="Create a new jsonbin.io bin using the API key above"/>
                        </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                            <Button x:Name="FetchSubmissionsBtn" Text="&#128229; Fetch Submissions" Clicked="OnFetchSubmissionsClicked"
                                    BackgroundColor="#8B5CF6" TextColor="White" FontSize="11" Padding="10,6" CornerRadius="6"/>
                            <Button x:Name="ImportFileBtn" Text="&#128194; Import File" Clicked="OnImportSubmissionsClicked"
                                    BackgroundColor="#64748B" TextColor="White" FontSize="11" Padding="10,6" CornerRadius="6"
                                    ToolTipProperties.Text="Import a JSON file exported from the website _submissions.html page"/>
                        </FlexLayout>
                        <Label x:Name="FetchStatusLabel" Text="" FontSize="10" TextColor="#64748B" IsVisible="False"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Records header -->
                <Grid Grid.Row="1" Padding="16,10,16,8" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" BackgroundColor="#F8FAFC">
                    <Label x:Name="EntriesHeaderLabel" Text="RECORDS (0)" FontAttributes="Bold" FontSize="14"
                           TextColor="#475569" VerticalOptions="Center"/>
                    <Button Grid.Column="1" x:Name="RefreshEntriesBtn" Text="&#128260;" IsEnabled="False"
                            Clicked="OnRefreshEntriesClicked" BackgroundColor="Transparent" TextColor="#3B82F6"
                            FontSize="14" Padding="6,4" WidthRequest="36" HeightRequest="36"
                            ToolTipProperties.Text="Refresh entries"/>
                    <Button Grid.Column="2" x:Name="AddEntryBtn" Text="+ Log Entry" IsEnabled="False"
                            Clicked="OnAddEntryClicked" BackgroundColor="#3B82F6" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                    <Button Grid.Column="3" x:Name="DeleteEntryBtn" Text="&#128465;" IsEnabled="False"
                            Clicked="OnDeleteEntryClicked" BackgroundColor="Transparent" TextColor="#EF4444"
                            FontSize="14" Padding="6,4" WidthRequest="36" HeightRequest="36"/>
                </Grid>

                <!-- Records content (scrollable) -->
                <ScrollView Grid.Row="2">
                    <VerticalStackLayout Padding="16,4" Spacing="12">

                        <!-- Placeholder when no form selected -->
                        <VerticalStackLayout x:Name="RecordsPlaceholder" VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                            <Label Text="&#128203;" FontSize="36" HorizontalOptions="Center" Margin="0,40,0,0"/>
                            <Label Text="Select a form to view its records" FontSize="14" FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                            <Label Text="Submitted entries will appear here" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Records panel (shown when form is selected) -->
                        <VerticalStackLayout x:Name="RecordsPanel" IsVisible="False" Spacing="12">
                            <Label Text="Review queue — importing does not create teams or confirm registrations." FontSize="12" TextColor="#475569" LineBreakMode="WordWrap"/>
                            <SearchBar x:Name="EntrySearchBar" Placeholder="Search entries or field values" TextChanged="OnEntryFilterChanged"/>
                            <Picker x:Name="EntryFilterPicker" Title="Status filter" SelectedIndexChanged="OnEntryFilterChanged" FontSize="12">
                                <Picker.ItemsSource><x:Array Type="{x:Type x:String}"><x:String>All entries</x:String><x:String>Pending</x:String><x:String>Confirmed</x:String><x:String>Rejected</x:String></x:Array></Picker.ItemsSource>
                            </Picker>

                            <!-- Entries list -->
                            <CollectionView x:Name="EntriesCollection" SelectionMode="Single"
                                            SelectionChanged="OnEntrySelected" HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame Padding="10" Margin="0,3" CornerRadius="8"
                                               BorderColor="#E2E8F0" BackgroundColor="White" HasShadow="False">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Frame Padding="5,3" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                                                       BackgroundColor="{Binding StatusColor}" VerticalOptions="Center">
                                                    <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="White"/>
                                                </Frame>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="{Binding EntryName}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding DateLabel}" FontSize="11" TextColor="#94A3B8"/>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding LinkedTeamLabel}" FontSize="11"
                                                       TextColor="#10B981" VerticalOptions="Center"/>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4" Padding="16">
                                        <Label Text="No entries logged yet" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                        <Label Text="Entries submitted on the website will appear here after import" FontSize="11" TextColor="#CBD5E1"
                                               HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>

                            <!-- Entry detail panel -->
                            <Frame x:Name="EntryDetailPanel" IsVisible="False" BorderColor="#E2E8F0" Padding="14"
                                   CornerRadius="10" BackgroundColor="White">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="ENTRY DETAILS" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Entry Name" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                            <Entry x:Name="EntryNameEntry" Placeholder="e.g. The Aces" FontSize="13"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label Text="Status" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                            <Picker x:Name="EntryStatusPicker" FontSize="13">
                                                <Picker.ItemsSource>
                                                    <x:Array Type="{x:Type x:String}">
                                                        <x:String>pending</x:String>
                                                        <x:String>confirmed</x:String>
                                                        <x:String>rejected</x:String>
                                                    </x:Array>
                                                </Picker.ItemsSource>
                                            </Picker>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Link to Season Team" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                        <Picker x:Name="EntryTeamPicker" FontSize="13" Title="-- None --"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Notes" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                        <Editor x:Name="EntryNotesEditor" Placeholder="Any notes about this entry..."
                                                AutoSize="TextChanges" FontSize="13" HeightRequest="50"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout x:Name="EntryFieldsPanel" Spacing="6"/>
                                    <Button x:Name="SaveEntryBtn" Text="&#10003; Save Entry" Clicked="OnSaveEntryClicked"
                                            BackgroundColor="#3B82F6" TextColor="White" FontSize="12"
                                            Padding="12,8" CornerRadius="8" HorizontalOptions="Start"/>
                                </VerticalStackLayout>
                            </Frame>

                            <!-- Divider -->
                            <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,4"/>

                            <!-- TEAM CROSS-REFERENCE -->
                            <VerticalStackLayout x:Name="CrossRefSection" Spacing="8">
                                <Label Text="TEAM CROSS-REFERENCE" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>
                                <Label x:Name="CrossRefSummaryLabel" Text="" FontSize="12" TextColor="#475569"/>
                                <CollectionView x:Name="CrossRefList" HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                <Label Text="{Binding StatusIcon}" FontSize="16" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding TeamName}" FontSize="13" TextColor="#1E293B" VerticalOptions="Center"/>
                                                <Label Grid.Column="2" Text="{Binding EntryLabel}" FontSize="11" TextColor="{Binding EntryLabelColor}" VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>
