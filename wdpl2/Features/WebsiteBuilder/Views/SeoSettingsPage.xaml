<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.SeoSettingsPage"
             Title="SEO and Advanced">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="SEO and Advanced" FontSize="24" FontAttributes="Bold" TextColor="#3B82F6"/>
            <Label Text="Search engine optimization and custom CSS" FontSize="14" TextColor="#6B7280"/>
            
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Meta Description" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="A brief description for search engines (150-160 characters)" FontSize="12" TextColor="#6B7280"/>
                    <Editor x:Name="MetaDescriptionEditor" 
                            Placeholder="Official website of Your League - standings, fixtures, results..."
                            HeightRequest="80"
                            AutoSize="TextChanges"/>
                    <Label x:Name="MetaCharCount" Text="0 / 160 characters" FontSize="11" TextColor="#9CA3AF"/>
                </VerticalStackLayout>
            </Frame>
            
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Meta Keywords" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Keywords separated by commas (optional)" FontSize="12" TextColor="#6B7280"/>
                    <Entry x:Name="MetaKeywordsEntry" Placeholder="pool league, 8-ball, competition, standings"/>
                </VerticalStackLayout>
            </Frame>

            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Open Graph Image" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Image URL shown when sharing on social media (og:image)" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>
                    <Entry x:Name="OgImageEntry" Placeholder="https://yoursite.com/og-image.png" Keyboard="Url"/>
                    <Label Text="Recommended: 1200x630px" FontSize="11" TextColor="#9CA3AF"/>
                </VerticalStackLayout>
            </Frame>
            
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sitemap" FontSize="14" FontAttributes="Bold"/>
                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="GenerateSitemapCheck" IsChecked="False"/>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Generate sitemap.xml" VerticalOptions="Center"/>
                            <Label Text="Helps search engines index your site" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>
            
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Custom CSS" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Add custom styles to override the default theme (advanced)" FontSize="12" TextColor="#6B7280"/>
                    <Editor x:Name="CustomCssEditor" 
                            Placeholder="/* Example: .header { background: #000; } */"
                            HeightRequest="150"
                            FontFamily="Consolas"
                            AutoSize="TextChanges"
                            TextChanged="OnCustomCssChanged"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Warning: Invalid CSS may break your website layout" FontSize="11" TextColor="#F59E0B"/>
                        <Label x:Name="CssStatsLabel" Grid.Column="1" Text="" FontSize="11" TextColor="#9CA3AF"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Custom HTML Injection -->
            <Frame BorderColor="#F59E0B" Padding="15" CornerRadius="8" BackgroundColor="#FFFBEB">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Custom HTML Injection" FontSize="14" FontAttributes="Bold" TextColor="#92400E"/>
                    <Label Text="Inject custom HTML into specific parts of every page (analytics, tracking, widgets)" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>

                    <Label Text="Custom &lt;head&gt; HTML" FontSize="12" TextColor="#6B7280"/>
                    <Label Text="e.g., Google Analytics, custom fonts, meta tags" FontSize="11" TextColor="#9CA3AF"/>
                    <Editor x:Name="CustomHeadHtmlEditor" 
                            Placeholder="&lt;!-- Google Analytics --&gt;&#x0a;&lt;script async src=&quot;...&quot;&gt;&lt;/script&gt;"
                            HeightRequest="80"
                            FontFamily="Consolas"
                            AutoSize="TextChanges"/>

                    <Label Text="Custom HTML after &lt;body&gt;" FontSize="12" TextColor="#6B7280"/>
                    <Label Text="e.g., cookie consent banners, chat widgets" FontSize="11" TextColor="#9CA3AF"/>
                    <Editor x:Name="CustomBodyStartHtmlEditor" 
                            Placeholder="&lt;!-- Cookie banner or notification --&gt;"
                            HeightRequest="80"
                            FontFamily="Consolas"
                            AutoSize="TextChanges"/>

                    <Label Text="Custom HTML before &lt;/body&gt;" FontSize="12" TextColor="#6B7280"/>
                    <Label Text="e.g., tracking pixels, deferred scripts" FontSize="11" TextColor="#9CA3AF"/>
                    <Editor x:Name="CustomBodyEndHtmlEditor" 
                            Placeholder="&lt;!-- Tracking scripts --&gt;"
                            HeightRequest="80"
                            FontFamily="Consolas"
                            AutoSize="TextChanges"/>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Clicked="OnSaveClicked" 
                    BackgroundColor="#10B981"
                    Margin="0,10,0,0"/>
            
        </VerticalStackLayout>
    </ScrollView>
    
</ContentPage>
