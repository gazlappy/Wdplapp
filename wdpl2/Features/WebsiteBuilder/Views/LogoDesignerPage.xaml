<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             xmlns:ctl="clr-namespace:Wdpl2.Features.WebsiteBuilder.Views.Controls"
             x:Class="Wdpl2.Features.WebsiteBuilder.Views.LogoDesignerPage"
             Title="Logo Designer"
             BackgroundColor="#F1F5F9">

    <ContentPage.Resources>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderWidth" Value="0"/>
        </Style>
        <Style x:Key="TabBtnActive" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="TextColor" Value="#0F172A"/>
            <Setter Property="FontAttributes" Value="Bold"/>
        </Style>
        <Style TargetType="Label" x:Key="FieldLabel">
            <Setter Property="TextColor" Value="#475569"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style TargetType="Entry" x:Key="LightEntry">
            <Setter Property="TextColor" Value="#0F172A"/>
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
        </Style>
        <Style TargetType="Picker" x:Key="LightPicker">
            <Setter Property="TextColor" Value="#0F172A"/>
            <Setter Property="BackgroundColor" Value="#FFFFFF"/>
            <Setter Property="TitleColor" Value="#94A3B8"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- ===== Tab strip ===== -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="#E2E8F0" Padding="0">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="0" VerticalOptions="End">
                    <Button x:Name="TabTemplatesBtn" Text="📂 Templates"  Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="templates"/>
                    <Button x:Name="TabShapesBtn"    Text="🔷 Shapes"     Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="shapes"/>
                    <Button x:Name="TabBgBtn"        Text="🎨 Background" Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="background"/>
                    <Button x:Name="TabTextBtn"      Text="🔤 Text"       Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="text"/>
                    <Button x:Name="TabSubBtn"       Text="abc Subtitle"  Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="subtitle"/>
                    <Button x:Name="TabIconBtn"      Text="✨ Icon"       Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="icon"/>
                    <Button x:Name="TabImageBtn"     Text="🖼 Image"      Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="image"/>
                    <Button x:Name="TabLayerBtn"     Text="🧩 Layer"      Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="layer" IsVisible="False"/>
                    <Button x:Name="TabQuickBtn"     Text="⚡ Quick"      Style="{StaticResource TabBtn}" Clicked="OnTabClicked" CommandParameter="quick"/>
                </HorizontalStackLayout>
            </ScrollView>
        </Border>

        <!-- ===== Active tab ribbon ===== -->
        <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="10,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                <Label Grid.Row="0" x:Name="SelectionLabel"
                       Text="Tap an element on the canvas to edit it"
                       TextColor="#64748B" FontSize="12" FontAttributes="Italic"/>

                <Grid Grid.Row="1" ColumnDefinitions="*">

                    <!-- TEMPLATES -->
                    <ScrollView x:Name="TemplatesPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <HorizontalStackLayout x:Name="TemplatesRow" Spacing="6" VerticalOptions="Center"/>
                    </ScrollView>

                    <!-- SHAPES -->
                    <ScrollView x:Name="ShapesPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Click a shape to add it as a new layer" Style="{StaticResource FieldLabel}"/>
                            <HorizontalStackLayout x:Name="ShapesRow" Spacing="6"/>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- QUICK -->
                    <ScrollView x:Name="QuickPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalScrollBarVisibility="Never" HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Button Text="🎲 Random Design" Clicked="OnRandomClicked"
                                    BackgroundColor="#0EA5E9" TextColor="White" FontSize="13" Padding="12,8" CornerRadius="6"/>
                            <Button Text="↺ Reset to Default" Clicked="OnResetClicked"
                                    BackgroundColor="#94A3B8" TextColor="White" FontSize="13" Padding="12,8" CornerRadius="6"/>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- BACKGROUND -->
                    <ScrollView x:Name="BgPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Shape" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="BgShapePicker" WidthRequest="160" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnBgShapeChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Color 1" Style="{StaticResource FieldLabel}"/>
                                <ctl:ColorPickerView x:Name="BgColor1Picker" WidthRequest="200" ColorChanged="OnBgColor1Changed"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Color 2" Style="{StaticResource FieldLabel}"/>
                                <ctl:ColorPickerView x:Name="BgColor2Picker" WidthRequest="200" ColorChanged="OnBgColor2Changed"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Gradient" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="GradDirPicker" WidthRequest="130" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnGradDirChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>none</x:String>
                                            <x:String>diagonal</x:String>
                                            <x:String>vertical</x:String>
                                            <x:String>horizontal</x:String>
                                            <x:String>radial</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Border" Style="{StaticResource FieldLabel}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Switch x:Name="BorderSwitch" Toggled="OnBorderToggled"/>
                                    <ctl:ColorPickerView x:Name="BorderColorPicker" WidthRequest="170" ColorChanged="OnBorderColorChanged"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Pattern" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="PatternPicker" WidthRequest="130" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnPatternChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>none</x:String>
                                            <x:String>stripes</x:String>
                                            <x:String>dots</x:String>
                                            <x:String>grid</x:String>
                                            <x:String>diagonal-lines</x:String>
                                            <x:String>chevron</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Shadow" Style="{StaticResource FieldLabel}"/>
                                <Switch x:Name="ShapeShadowSwitch" Toggled="OnShapeShadowToggled"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- TEXT -->
                    <ScrollView x:Name="TextPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Text" Style="{StaticResource FieldLabel}"/>
                                <Entry x:Name="TextEntry" WidthRequest="160" Style="{StaticResource LightEntry}" TextChanged="OnTextChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Font" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="FontPicker" WidthRequest="140" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnFontChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Weight" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="WeightPicker" WidthRequest="100" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnWeightChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Regular</x:String>
                                            <x:String>Bold</x:String>
                                            <x:String>Black</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="160">
                                <Label x:Name="FontSizeLabel" Text="Size" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="FontSizeSlider" Minimum="40" Maximum="320" ValueChanged="OnFontSizeChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="140">
                                <Label x:Name="LetterSpacingLabel" Text="Spacing" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="LetterSpacingSlider" Minimum="-10" Maximum="40" ValueChanged="OnLetterSpacingChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Color" Style="{StaticResource FieldLabel}"/>
                                <ctl:ColorPickerView x:Name="TextColorPicker" WidthRequest="200" ColorChanged="OnTextColorChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Uppercase" Style="{StaticResource FieldLabel}"/>
                                <Switch x:Name="UppercaseSwitch" Toggled="OnUppercaseToggled"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Outline" Style="{StaticResource FieldLabel}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Switch x:Name="StrokeSwitch" Toggled="OnStrokeToggled"/>
                                    <ctl:ColorPickerView x:Name="StrokeColorPicker" WidthRequest="170" ColorChanged="OnStrokeColorChanged"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Shadow" Style="{StaticResource FieldLabel}"/>
                                <Switch x:Name="ShadowSwitch" Toggled="OnShadowToggled"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- SUBTITLE -->
                    <ScrollView x:Name="SubtitlePanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Subtitle" Style="{StaticResource FieldLabel}"/>
                                <Entry x:Name="SubtitleEntry" WidthRequest="200" Style="{StaticResource LightEntry}" TextChanged="OnSubtitleChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="160">
                                <Label x:Name="SubtitleSizeLabel" Text="Size" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="SubtitleSizeSlider" Minimum="14" Maximum="120" ValueChanged="OnSubtitleSizeChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Color" Style="{StaticResource FieldLabel}"/>
                                <ctl:ColorPickerView x:Name="SubtitleColorPicker" WidthRequest="200" ColorChanged="OnSubtitleColorChanged"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- ICON -->
                    <Grid x:Name="IconPanel" IsVisible="False" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="6">
                        <ScrollView x:Name="IconControlsScroll" Grid.Row="0" Orientation="Horizontal" HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Icon / emoji" Style="{StaticResource FieldLabel}"/>
                                    <Entry x:Name="IconEntry" WidthRequest="100" Style="{StaticResource LightEntry}" TextChanged="OnIconChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Category" Style="{StaticResource FieldLabel}"/>
                                    <Picker x:Name="IconCategoryPicker" WidthRequest="130" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnIconCategoryChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="140">
                                    <Label x:Name="IconSizeLabel" Text="Size" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="IconSizeSlider" Minimum="40" Maximum="320" ValueChanged="OnIconSizeChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="140">
                                    <Label x:Name="IconRotLabel" Text="Rotation" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="IconRotSlider" Minimum="-180" Maximum="180" ValueChanged="OnIconRotChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Color" Style="{StaticResource FieldLabel}"/>
                                    <ctl:ColorPickerView x:Name="IconColorPicker" WidthRequest="200" ColorChanged="OnIconColorChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Position" Style="{StaticResource FieldLabel}"/>
                                    <Picker x:Name="IconPosPicker" WidthRequest="110" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnIconPosChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>above</x:String>
                                                <x:String>below</x:String>
                                                <x:String>left</x:String>
                                                <x:String>right</x:String>
                                                <x:String>behind</x:String>
                                                <x:String>custom</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </VerticalStackLayout>
                                <Button Text="✕ Clear" Clicked="OnIconClearClicked"
                                        BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,6" CornerRadius="6"/>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <ScrollView x:Name="IconGridScroll" Grid.Row="1" Orientation="Horizontal" HorizontalOptions="Fill">
                            <HorizontalStackLayout x:Name="IconRow" Spacing="4"/>
                        </ScrollView>
                    </Grid>

                    <!-- IMAGE -->
                    <Grid x:Name="ImagePanel" IsVisible="False" RowDefinitions="Auto,Auto" ColumnDefinitions="*" RowSpacing="6">
                        <ScrollView x:Name="ImageControlsScroll" Grid.Row="0" Orientation="Horizontal" HorizontalOptions="Fill">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Button Text="📁 Pick image…" Clicked="OnPickImageClicked"
                                        BackgroundColor="#0EA5E9" TextColor="White" FontSize="12" Padding="10,6" CornerRadius="6"/>
                                <Button Text="✕ Clear" Clicked="OnImageClearClicked"
                                        BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,6" CornerRadius="6"/>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Position" Style="{StaticResource FieldLabel}"/>
                                    <Picker x:Name="ImagePosPicker" WidthRequest="120" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnImagePosChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>center</x:String>
                                                <x:String>above</x:String>
                                                <x:String>below</x:String>
                                                <x:String>behind</x:String>
                                                <x:String>fill</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="160">
                                    <Label x:Name="ImageSizeLabel" Text="Size" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="ImageSizeSlider" Minimum="40" Maximum="500" ValueChanged="OnImageSizeChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="140">
                                    <Label x:Name="ImageOpacityLabel" Text="Opacity" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="ImageOpacitySlider" Minimum="0" Maximum="1" ValueChanged="OnImageOpacityChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="140">
                                    <Label x:Name="ImageRotLabel" Text="Rotation" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="ImageRotSlider" Minimum="-180" Maximum="180" ValueChanged="OnImageRotChanged"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="2" WidthRequest="140">
                                    <Label x:Name="ImageOffsetLabel" Text="Y offset" Style="{StaticResource FieldLabel}"/>
                                    <Slider x:Name="ImageOffsetSlider" Minimum="-200" Maximum="200" ValueChanged="OnImageOffsetChanged"/>
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </ScrollView>
                        <ScrollView x:Name="ImageGalleryScroll" Grid.Row="1" Orientation="Horizontal" HorizontalOptions="Fill">
                            <HorizontalStackLayout x:Name="ImageGalleryRow" Spacing="4"/>
                        </ScrollView>
                    </Grid>

                    <!-- LAYER -->
                    <ScrollView x:Name="LayerPanel" Orientation="Horizontal" IsVisible="False"
                                HorizontalOptions="Fill">
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Shape" Style="{StaticResource FieldLabel}"/>
                                <Picker x:Name="LayerShapePicker" WidthRequest="160" Style="{StaticResource LightPicker}" SelectedIndexChanged="OnLayerShapeChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="120">
                                <Label x:Name="LayerWidthLabel" Text="Width" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="LayerWidthSlider" Minimum="0.05" Maximum="1.2" ValueChanged="OnLayerWidthChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="120">
                                <Label x:Name="LayerHeightLabel" Text="Height" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="LayerHeightSlider" Minimum="0.05" Maximum="1.2" ValueChanged="OnLayerHeightChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="120">
                                <Label x:Name="LayerRotLabel" Text="Rotation" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="LayerRotSlider" Minimum="-180" Maximum="180" ValueChanged="OnLayerRotChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2" WidthRequest="120">
                                <Label x:Name="LayerOpacityLabel" Text="Opacity" Style="{StaticResource FieldLabel}"/>
                                <Slider x:Name="LayerOpacitySlider" Minimum="0" Maximum="1" ValueChanged="OnLayerOpacityChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Fill" Style="{StaticResource FieldLabel}"/>
                                <ctl:ColorPickerView x:Name="LayerFillPicker" WidthRequest="200" ColorChanged="OnLayerFillChanged"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Gradient" Style="{StaticResource FieldLabel}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Switch x:Name="LayerGradSwitch" Toggled="OnLayerGradToggled"/>
                                    <ctl:ColorPickerView x:Name="LayerFill2Picker" WidthRequest="170" ColorChanged="OnLayerFill2Changed"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Outline" Style="{StaticResource FieldLabel}"/>
                                <HorizontalStackLayout Spacing="6">
                                    <Switch x:Name="LayerStrokeSwitch" Toggled="OnLayerStrokeToggled"/>
                                    <ctl:ColorPickerView x:Name="LayerStrokePicker" WidthRequest="170" ColorChanged="OnLayerStrokeColorChanged"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Above text" Style="{StaticResource FieldLabel}"/>
                                <Switch x:Name="LayerAboveSwitch" Toggled="OnLayerAboveToggled"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Order / Actions" Style="{StaticResource FieldLabel}"/>
                                <HorizontalStackLayout Spacing="4">
                                    <Button Text="⬆"  Clicked="OnLayerUpClicked"        BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="13" Padding="8,4"/>
                                    <Button Text="⬇"  Clicked="OnLayerDownClicked"      BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="13" Padding="8,4"/>
                                    <Button Text="⧉"  Clicked="OnLayerDuplicateClicked" BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="13" Padding="8,4"/>
                                    <Button Text="🗑" Clicked="OnDeleteLayerClicked"    BackgroundColor="#FECACA" TextColor="#0F172A" FontSize="13" Padding="8,4"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </ScrollView>

                </Grid>
            </Grid>
        </Border>

        <!-- ===== Canvas ===== -->
        <Grid Grid.Row="2" BackgroundColor="#F1F5F9" Padding="16" RowDefinitions="Auto,*" RowSpacing="8">

            <!-- Floating action bar for the selected element -->
            <Border Grid.Row="0" x:Name="SelectionActionBar" IsVisible="False"
                    StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="#FFFFFF"
                    Padding="6,4" HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8"/>
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Label x:Name="ActionBarLabel" Text="" TextColor="#475569" FontSize="12"
                           VerticalOptions="Center" Padding="6,0"/>
                    <Button Text="⬆ Front"  Clicked="OnLayerUpClicked"        BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,4" CornerRadius="4"/>
                    <Button Text="⬇ Back"   Clicked="OnLayerDownClicked"      BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,4" CornerRadius="4"/>
                    <Button Text="⧉ Copy"   Clicked="OnLayerDuplicateClicked" BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,4" CornerRadius="4"/>
                    <Button Text="⚙ More"   Clicked="OnSelectionMoreClicked"  BackgroundColor="#E2E8F0" TextColor="#0F172A" FontSize="12" Padding="8,4" CornerRadius="4"/>
                    <Button Text="🗑 Delete" Clicked="OnDeleteSelectionClicked" BackgroundColor="#FECACA" TextColor="#0F172A" FontSize="12" Padding="8,4" CornerRadius="4"/>
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Row="1" StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="#FFFFFF"
                    HorizontalOptions="Center" VerticalOptions="Center">
                <skia:SKCanvasView x:Name="Preview"
                                   WidthRequest="480" HeightRequest="480"
                                   EnableTouchEvents="True"
                                   PaintSurface="OnPaintPreview"
                                   Touch="OnCanvasTouch"/>
            </Border>
        </Grid>

        <!-- ===== Bottom save bar ===== -->
        <Border Grid.Row="3" StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="10,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Entry Grid.Column="0" x:Name="NameEntry" Placeholder="Logo name (e.g. WDPL Crest)"
                       Style="{StaticResource LightEntry}" PlaceholderColor="#94A3B8"/>
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="#E2E8F0" TextColor="#0F172A"/>
                <Button Grid.Column="2" Text="💾 Save to Catalog" Clicked="OnSaveClicked"
                        BackgroundColor="#10B981" TextColor="White"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
