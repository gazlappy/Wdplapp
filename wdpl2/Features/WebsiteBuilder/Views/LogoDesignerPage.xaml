<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="Wdpl2.Features.WebsiteBuilder.Views.LogoDesignerPage"
             Title="Logo Designer">

    <Grid ColumnDefinitions="*,360" RowDefinitions="*,Auto">

        <!-- Live preview -->
        <Frame Grid.Column="0" Grid.Row="0" Margin="20" Padding="20" BorderColor="#E5E7EB"
               BackgroundColor="#F1F5F9" CornerRadius="12">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                <Label Text="Preview" FontSize="14" FontAttributes="Bold" TextColor="#475569"/>
                <skia:SKCanvasView Grid.Row="1" x:Name="PreviewCanvas"
                                   PaintSurface="OnPaintPreview"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   WidthRequest="420" HeightRequest="420"/>
                <Label Grid.Row="2" Text="The exported PNG is 512×512 with transparent background outside the shape."
                       FontSize="11" TextColor="#94A3B8" HorizontalOptions="Center"/>
            </Grid>
        </Frame>

        <!-- Controls -->
        <ScrollView Grid.Column="1" Grid.Row="0" Padding="16,20,20,10">
            <VerticalStackLayout Spacing="16">

                <Label Text="Design Your Logo" FontSize="20" FontAttributes="Bold" TextColor="#3B82F6"/>
                <Label x:Name="ModeLabel" Text="Creating new logo" FontSize="12" TextColor="#6B7280"/>

                <!-- Quick actions: templates, random, reset -->
                <Frame Padding="10" BorderColor="#E5E7EB" CornerRadius="8" BackgroundColor="#F8FAFC">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Quick Start" FontAttributes="Bold" FontSize="13"/>
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="🎲 Random" FontSize="12" Padding="10,4" Clicked="OnRandomClicked" BackgroundColor="#8B5CF6" TextColor="White"/>
                            <Button Text="↺ Reset" FontSize="12" Padding="10,4" Clicked="OnResetClicked" BackgroundColor="#94A3B8" TextColor="White"/>
                        </HorizontalStackLayout>
                        <Label Text="Templates" FontSize="12" TextColor="#475569"/>
                        <FlexLayout x:Name="TemplatesFlex" Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Text -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Text / Monogram" FontAttributes="Bold" FontSize="13"/>
                        <Entry x:Name="TextEntry" Placeholder="WDPL" TextChanged="OnAnyChanged"/>
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="UppercaseCheck" IsChecked="True" CheckedChanged="OnAnyChanged"/>
                            <Label Text="UPPERCASE" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>

                        <Label Text="Font family" FontSize="12"/>
                        <Picker x:Name="FontFamilyPicker" SelectedIndexChanged="OnAnyChanged"/>

                        <Label Text="Font weight" FontSize="12"/>
                        <Picker x:Name="FontWeightPicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Regular</x:String>
                                    <x:String>Bold</x:String>
                                    <x:String>Black</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Size" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="FontSizeSlider" Minimum="40" Maximum="320" Value="180" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="FontSizeLabel" Text="180" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Letter spacing" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="LetterSpacingSlider" Minimum="-10" Maximum="40" Value="0" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="LetterSpacingLabel" Text="0" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Rotate" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="TextRotationSlider" Minimum="-45" Maximum="45" Value="0" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="TextRotationLabel" Text="0°" FontSize="11" WidthRequest="40" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Nudge Y" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="TextOffsetYSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="TextOffsetYLabel" Text="0" FontSize="11" WidthRequest="40" VerticalOptions="Center"/>
                        </Grid>

                        <Label Text="Text color" FontSize="12"/>
                        <Entry x:Name="TextColorEntry" Text="#FFFFFF" TextChanged="OnAnyChanged" Placeholder="#FFFFFF"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Text effects -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Text Effects" FontAttributes="Bold" FontSize="13"/>
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="TextStrokeCheck" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Outline" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="TextStrokeColorEntry" Text="#0F172A" TextChanged="OnAnyChanged" Placeholder="Outline color"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Width" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="TextStrokeWidthSlider" Minimum="1" Maximum="20" Value="4" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="TextStrokeWidthLabel" Text="4" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>

                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="TextShadowCheck" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Drop shadow / glow" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="TextShadowColorEntry" Text="#000000" TextChanged="OnAnyChanged" Placeholder="Shadow color"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Blur" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="TextShadowBlurSlider" Minimum="0" Maximum="40" Value="6" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="TextShadowBlurLabel" Text="6" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Offset Y" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="TextShadowOffsetYSlider" Minimum="-20" Maximum="40" Value="4" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="TextShadowOffsetYLabel" Text="4" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Subtitle -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Subtitle (optional)" FontAttributes="Bold" FontSize="13"/>
                        <Entry x:Name="SubtitleEntry" Placeholder="EST. 1985" TextChanged="OnAnyChanged"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Size" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="SubtitleSizeSlider" Minimum="14" Maximum="100" Value="36" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="SubtitleSizeLabel" Text="36" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Tracking" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="SubtitleSpacingSlider" Minimum="0" Maximum="30" Value="6" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="SubtitleSpacingLabel" Text="6" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Entry x:Name="SubtitleColorEntry" Text="#FFFFFF" TextChanged="OnAnyChanged" Placeholder="Subtitle color"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Icon -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Icon (optional)" FontAttributes="Bold" FontSize="13"/>
                        <Label Text="Paste an emoji or short symbol — e.g. 🎱  🏆  ⭐" FontSize="11" TextColor="#6B7280"/>
                        <Entry x:Name="IconEntry" Placeholder="🎱" TextChanged="OnAnyChanged"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Size" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="IconSizeSlider" Minimum="40" Maximum="320" Value="120" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="IconSizeLabel" Text="120" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Rotate" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="IconRotationSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="IconRotationLabel" Text="0°" FontSize="11" WidthRequest="40" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="Position" FontSize="12"/>
                        <Picker x:Name="IconPositionPicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Above text</x:String>
                                    <x:String>Below text</x:String>
                                    <x:String>Left of text</x:String>
                                    <x:String>Right of text</x:String>
                                    <x:String>Behind text (faded)</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <HorizontalStackLayout Spacing="4">
                            <Button Text="🎱" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="🏆" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="⭐" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="🎯" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="🔥" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="⚽" FontSize="18" Padding="8,4" Clicked="OnIconQuickPick"/>
                            <Button Text="✖" FontSize="14" Padding="8,4" Clicked="OnIconClear" ToolTipProperties.Text="Clear icon"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Background shape -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Background Shape" FontAttributes="Bold" FontSize="13"/>
                        <Picker x:Name="ShapePicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Circle</x:String>
                                    <x:String>Rounded square</x:String>
                                    <x:String>Square</x:String>
                                    <x:String>Shield</x:String>
                                    <x:String>Hexagon</x:String>
                                    <x:String>Octagon</x:String>
                                    <x:String>Triangle</x:String>
                                    <x:String>Diamond</x:String>
                                    <x:String>Star</x:String>
                                    <x:String>Banner ribbon</x:String>
                                    <x:String>None (transparent)</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>

                        <Label Text="Background color 1" FontSize="12"/>
                        <Entry x:Name="BgColor1Entry" Text="#3B82F6" TextChanged="OnAnyChanged"/>

                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="GradientCheck" IsChecked="True" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Use gradient" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>

                        <Label Text="Background color 2 (gradient)" FontSize="12"/>
                        <Entry x:Name="BgColor2Entry" Text="#1E40AF" TextChanged="OnAnyChanged"/>

                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="ThreeColorCheck" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Add third color stop" VerticalOptions="Center" FontSize="12"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="BgColor3Entry" Text="#9333EA" TextChanged="OnAnyChanged" Placeholder="#9333EA"/>

                        <Label Text="Gradient direction" FontSize="12"/>
                        <Picker x:Name="GradientDirPicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Diagonal</x:String>
                                    <x:String>Vertical</x:String>
                                    <x:String>Horizontal</x:String>
                                    <x:String>Radial</x:String>
                                    <x:String>Custom angle</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Angle" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="GradientAngleSlider" Minimum="0" Maximum="360" Value="45" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="GradientAngleLabel" Text="45°" FontSize="11" WidthRequest="40" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Padding" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="PaddingSlider" Minimum="0" Maximum="80" Value="24" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="PaddingLabel" Text="24" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Pattern overlay -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pattern Overlay" FontAttributes="Bold" FontSize="13"/>
                        <Picker x:Name="PatternPicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>None</x:String>
                                    <x:String>Stripes</x:String>
                                    <x:String>Dots</x:String>
                                    <x:String>Grid</x:String>
                                    <x:String>Diagonal lines</x:String>
                                    <x:String>Chevron</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Entry x:Name="PatternColorEntry" Text="#FFFFFF" TextChanged="OnAnyChanged" Placeholder="Pattern color"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Opacity" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="PatternOpacitySlider" Minimum="0" Maximum="1" Value="0.12" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="PatternOpacityLabel" Text="12%" FontSize="11" WidthRequest="40" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Scale" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="PatternScaleSlider" Minimum="6" Maximum="80" Value="24" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="PatternScaleLabel" Text="24" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Border -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="BorderCheck" IsChecked="False" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Show border" VerticalOptions="Center" FontSize="12" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Label Text="Border color" FontSize="12"/>
                        <Entry x:Name="BorderColorEntry" Text="#FFFFFF" TextChanged="OnAnyChanged"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Width" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="BorderWidthSlider" Minimum="1" Maximum="40" Value="6" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="BorderWidthLabel" Text="6" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="Style" FontSize="12"/>
                        <Picker x:Name="BorderStylePicker" SelectedIndexChanged="OnAnyChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Solid</x:String>
                                    <x:String>Dashed</x:String>
                                    <x:String>Dotted</x:String>
                                    <x:String>Double</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </VerticalStackLayout>
                </Frame>

                <!-- Shape shadow -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox x:Name="ShapeShadowCheck" CheckedChanged="OnAnyChanged"/>
                            <Label Text="Shape drop shadow" VerticalOptions="Center" FontSize="12" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                        <Entry x:Name="ShapeShadowColorEntry" Text="#000000" TextChanged="OnAnyChanged" Placeholder="Shadow color"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Blur" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="ShapeShadowBlurSlider" Minimum="0" Maximum="60" Value="16" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="ShapeShadowBlurLabel" Text="16" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <Label Text="Offset Y" VerticalOptions="Center" FontSize="12"/>
                            <Slider Grid.Column="1" x:Name="ShapeShadowOffsetYSlider" Minimum="0" Maximum="40" Value="8" ValueChanged="OnAnyChanged"/>
                            <Label Grid.Column="2" x:Name="ShapeShadowOffsetYLabel" Text="8" FontSize="11" WidthRequest="32" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Quick presets -->
                <Frame Padding="12" BorderColor="#E5E7EB" CornerRadius="8">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Color presets" FontAttributes="Bold" FontSize="13"/>
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Center">
                            <Button Text="Blue" BackgroundColor="#3B82F6" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#3B82F6|#1E40AF"/>
                            <Button Text="Emerald" BackgroundColor="#10B981" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#10B981|#047857"/>
                            <Button Text="Sunset" BackgroundColor="#F97316" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#F97316|#DC2626"/>
                            <Button Text="Purple" BackgroundColor="#8B5CF6" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#8B5CF6|#6D28D9"/>
                            <Button Text="Slate" BackgroundColor="#475569" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#475569|#0F172A"/>
                            <Button Text="Rose" BackgroundColor="#F43F5E" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#F43F5E|#BE123C"/>
                            <Button Text="Teal" BackgroundColor="#14B8A6" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#14B8A6|#0F766E"/>
                            <Button Text="Gold" BackgroundColor="#F59E0B" TextColor="White" FontSize="11" Padding="10,4" Margin="0,0,4,4" Clicked="OnPreset" CommandParameter="#F59E0B|#B45309"/>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom action bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                Stroke="#E5E7EB" StrokeThickness="1"
                BackgroundColor="#FFFFFF" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0" x:Name="LogoNameEntry" Placeholder="Logo name (e.g. WDPL Mark)"/>
                <Button Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="#9CA3AF"/>
                <Button Grid.Column="2" x:Name="SaveBtn" Text="Save to Catalog" Clicked="OnSaveClicked" BackgroundColor="#10B981"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
