<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.CompetitionsSettingsPage"
             Title="Competitions Page Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Competitions Page" FontSize="24" FontAttributes="Bold" TextColor="#3B82F6"/>
            <Label Text="Choose the order competitions appear on the public Competitions page."
                   FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap"/>

            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Display Order" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Use the ↑/↓ buttons to re-order. Top of the list shows first on the website."
                           FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>

                    <VerticalStackLayout x:Name="OrderList" Spacing="6"/>

                    <Label x:Name="EmptyMessage"
                           Text="No competitions to display. Create a competition (and set its status to In Progress or Completed) first."
                           FontSize="12" TextColor="#9CA3AF" IsVisible="False" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Cancel" Clicked="OnCancelClicked"
                        BackgroundColor="#E5E7EB" TextColor="#111827" CornerRadius="8"/>
                <Button Grid.Column="1" Text="Save" Clicked="OnSaveClicked"
                        BackgroundColor="#3B82F6" TextColor="White" CornerRadius="8"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
