<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.WebsiteBuilderHub"
             Title="Website Builder">

    <Grid ColumnDefinitions="380,*" ColumnSpacing="0">

        <!-- ═══ LEFT PANEL: Settings ═══ -->
        <ScrollView Grid.Column="0" BackgroundColor="#F8FAFC">
            <VerticalStackLayout Padding="20,16" Spacing="10">

                <Label Text="Website Builder" FontSize="22" FontAttributes="Bold" TextColor="#1E293B"/>
                <Label Text="Design and publish your league website" FontSize="12" TextColor="#64748B"/>

                <!-- Setup Progress -->
                <Frame BorderColor="#E2E8F0" Padding="12" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Setup Progress" FontAttributes="Bold" FontSize="12" TextColor="#475569"/>
                            <Label x:Name="SetupProgressLabel" Grid.Column="1" FontSize="12" FontAttributes="Bold" TextColor="#3B82F6"/>
                        </Grid>
                        <ProgressBar x:Name="SetupProgressBar" ProgressColor="#3B82F6" HeightRequest="6"/>
                        <Label x:Name="SetupHintLabel" FontSize="11" TextColor="#94A3B8"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" x:Name="PreviewBtn" Text="&#128065; Preview"
                            Clicked="OnPreviewClicked" BackgroundColor="#3B82F6" FontSize="12" 
                            Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="1" x:Name="DeployBtn" Text="&#128640; Deploy"
                            Clicked="OnDeployClicked" BackgroundColor="#10B981" FontSize="12" 
                            Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="2" x:Name="SaveBtn" Text="&#128190; Save"
                            Clicked="OnSaveClicked" BackgroundColor="#64748B" FontSize="12" 
                            Padding="8,10" CornerRadius="8"/>
                </Grid>

                <Label x:Name="StatusLabel" FontSize="12" TextColor="#10B981" IsVisible="False"/>
                <Label x:Name="LastActivityLabel" FontSize="11" TextColor="#94A3B8" IsVisible="False"/>
                <ProgressBar x:Name="ProgressBar" IsVisible="False" ProgressColor="#3B82F6"/>

                <!-- Season and Template -->
                <Frame BorderColor="#3B82F6" Padding="14" CornerRadius="10" BackgroundColor="#EFF6FF">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="&#127942; Season and Template" FontAttributes="Bold" FontSize="13" TextColor="#1E40AF"/>
                        <Picker x:Name="SeasonPicker" Title="Select Season"/>
                        <Picker x:Name="TemplatePicker" Title="Select Template"/>
                        <Label x:Name="TemplateDescription" FontSize="11" TextColor="#6B7280" IsVisible="False" LineBreakMode="WordWrap"/>
                        <FlexLayout x:Name="TemplateFeaturesLayout" Wrap="Wrap" Direction="Row" 
                                    JustifyContent="Start" AlignItems="Center" IsVisible="False">
                        </FlexLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- ── Branding ── -->
                <Label Text="BRANDING" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" 
                       Margin="0,8,0,0" CharacterSpacing="1.5"/>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandingTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#EFF6FF" Padding="0" CornerRadius="8" 
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#127912;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Site Branding" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="BrandingSummaryLabel" Text="Name, logo, favicon" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnContactTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#F0FDF4" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128233;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Contact and Social" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="ContactSummaryLabel" Text="Email, phone, social links" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- ── Design ── -->
                <Label Text="DESIGN" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" 
                       Margin="0,8,0,0" CharacterSpacing="1.5"/>

                <Frame BorderColor="#F59E0B" Padding="0" CornerRadius="10" BackgroundColor="#FFFBEB">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDragDropLayoutTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#FEF3C7" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="⚡" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Visual Layout Editor" FontAttributes="Bold" FontSize="13" TextColor="#92400E"/>
                            <Label Text="Drag-and-drop page layout" FontSize="11" TextColor="#A16207"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#D97706" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnColorsTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#FDF2F8" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#127752;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Colors and Theme" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="ColorsSummaryLabel" Text="Color scheme and presets" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLayoutTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#EFF6FF" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128208;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Layout and Styling" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="LayoutSummaryLabel" Text="Header, nav, footer, fonts" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- ── Content ── -->
                <Label Text="CONTENT" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" 
                       Margin="0,8,0,0" CharacterSpacing="1.5"/>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnContentTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#F0FDF4" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128196;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Pages and Content" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="ContentSummaryLabel" Text="Choose pages, home layout" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnGalleryTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#FEF3C7" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128247;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Photo Gallery" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="GalleryCountLabel" Text="Manage photos (0 images)" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnRowsReportsTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#EDE9FE" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128221;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Rows Reports" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="RowsReportsCountLabel" Text="Weekly match reports (0)" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- ── Print/Export ── -->
                <Label Text="PRINT &amp; EXPORT" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" 
                       Margin="0,8,0,0" CharacterSpacing="1.5"/>

                <Frame BorderColor="#10B981" Padding="0" CornerRadius="10" BackgroundColor="#F0FDF4">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFixturesSheetTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#D1FAE5" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128438;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Fixtures Sheet" FontAttributes="Bold" FontSize="13" TextColor="#065F46"/>
                            <Label Text="Generate printable fixtures" FontSize="11" TextColor="#059669"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#6EE7B7" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- ── Advanced ── -->
                <Label Text="ADVANCED" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" 
                       Margin="0,8,0,0" CharacterSpacing="1.5"/>

                <Frame BorderColor="#E2E8F0" Padding="0" CornerRadius="10" BackgroundColor="White">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSeoTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#F5F3FF" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128269;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="SEO and Advanced" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                            <Label x:Name="SeoSummaryLabel" Text="Meta tags, custom CSS, HTML" FontSize="11" TextColor="#64748B"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#CBD5E1" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#3B82F6" Padding="0" CornerRadius="10" BackgroundColor="#EFF6FF">
                    <Grid Padding="14" ColumnDefinitions="36,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDeploymentTapped"/></Grid.GestureRecognizers>
                        <Frame Grid.Column="0" BackgroundColor="#DBEAFE" Padding="0" CornerRadius="8"
                               HeightRequest="36" WidthRequest="36" HasShadow="False" BorderColor="Transparent">
                            <Label Text="&#128640;" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" VerticalOptions="Center">
                            <Label Text="Deployment" FontAttributes="Bold" FontSize="13" TextColor="#1E40AF"/>
                            <Label Text="Export, GitHub Pages, FTP" FontSize="11" TextColor="#3B82F6"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" FontSize="22" TextColor="#93C5FD" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Reset -->
                <Button x:Name="ResetBtn" Text="&#128260; Reset All Settings"
                        Clicked="OnResetClicked" BackgroundColor="Transparent" TextColor="#EF4444"
                        FontSize="12" Margin="0,12,0,8" BorderColor="#FCA5A5" BorderWidth="1" 
                        CornerRadius="8" Padding="8,10"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Divider line -->
        <BoxView Grid.Column="0" WidthRequest="1" BackgroundColor="#E2E8F0" HorizontalOptions="End"/>

        <!-- ═══ RIGHT PANEL: Live Preview ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="0">

            <!-- Preview toolbar -->
            <Grid BackgroundColor="#1E293B" Padding="14,10" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="Live Preview" FontAttributes="Bold" FontSize="14"
                       TextColor="White" VerticalOptions="Center"/>
                <Picker Grid.Column="2" x:Name="PreviewPagePicker" Title="Page"
                        WidthRequest="150" SelectedIndexChanged="OnPreviewPageChanged"
                        TextColor="White" TitleColor="#94A3B8"/>
                <Button Grid.Column="3" x:Name="RefreshPreviewBtn" Text="&#128260; Refresh"
                        Clicked="OnPreviewClicked" BackgroundColor="#3B82F6" TextColor="White"
                        FontSize="12" Padding="12,8" CornerRadius="6"/>
            </Grid>

            <!-- Preview placeholder / WebView -->
            <Grid Grid.Row="1" BackgroundColor="#F1F5F9">
                <!-- Placeholder shown when no preview generated yet -->
                <VerticalStackLayout x:Name="PreviewPlaceholder"
                                     VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                    <Label Text="&#127760;" FontSize="56" HorizontalOptions="Center"/>
                    <Label Text="Click Preview to see your website" FontSize="18"
                           FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                    <Label Text="Configure your settings on the left, then hit Preview" FontSize="13"
                           TextColor="#94A3B8" HorizontalOptions="Center"/>
                    <Button Text="&#128065; Generate Preview" Clicked="OnPreviewClicked" 
                            BackgroundColor="#3B82F6" TextColor="White" FontSize="13"
                            Padding="24,12" CornerRadius="8" HorizontalOptions="Center" Margin="0,8,0,0"/>
                </VerticalStackLayout>

                <!-- The WebView (hidden initially) -->
                <WebView x:Name="PreviewWebView" IsVisible="False"
                         Navigating="OnPreviewNavigating"/>
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
