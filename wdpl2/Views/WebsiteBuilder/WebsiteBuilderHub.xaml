<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.WebsiteBuilderHub"
             Title="Website Builder">

    <Grid ColumnDefinitions="360,*" ColumnSpacing="0">

        <!-- ═══ LEFT PANEL: Settings ═══ -->
        <ScrollView Grid.Column="0" BackgroundColor="#FAFBFC">
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Website Builder" FontSize="22" FontAttributes="Bold" TextColor="#3B82F6"/>
                <Label Text="Design and publish your league website" FontSize="12" TextColor="#6B7280"/>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Grid.Column="0" x:Name="PreviewBtn" Text="&#128065; Preview"
                            Clicked="OnPreviewClicked" BackgroundColor="#3B82F6" FontSize="11" Padding="6,8"/>
                    <Button Grid.Column="1" x:Name="DeployBtn" Text="&#128640; Deploy"
                            Clicked="OnDeployClicked" BackgroundColor="#10B981" FontSize="11" Padding="6,8"/>
                    <Button Grid.Column="2" x:Name="SaveBtn" Text="&#128190; Save"
                            Clicked="OnSaveClicked" BackgroundColor="#6B7280" FontSize="11" Padding="6,8"/>
                </Grid>

                <Label x:Name="StatusLabel" FontSize="12" TextColor="#10B981" IsVisible="False"/>
                <ProgressBar x:Name="ProgressBar" IsVisible="False" ProgressColor="#3B82F6"/>

                <!-- Season and Template -->
                <Frame BorderColor="#3B82F6" Padding="12" CornerRadius="8" BackgroundColor="#EFF6FF">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Season and Template" FontAttributes="Bold" FontSize="13"/>
                        <Picker x:Name="SeasonPicker" Title="Select Season"/>
                        <Picker x:Name="TemplatePicker" Title="Select Template"/>
                        <Label x:Name="TemplateDescription" FontSize="11" TextColor="#6B7280" IsVisible="False"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Branding -->
                <Label Text="Branding" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnBrandingTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[B]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Site Branding" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Name, logo, subtitle" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnContactTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[C]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Contact and Social" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Email, phone, social links" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Design -->
                <Label Text="Design" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Frame BorderColor="#F59E0B" Padding="0" CornerRadius="8" BackgroundColor="#FFFBEB">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDragDropLayoutTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="⚡" FontSize="16" VerticalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Visual Layout Editor" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Live drag-and-drop editor" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnColorsTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[T]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Colors and Theme" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Color schemes, presets" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnLayoutTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[L]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Layout and Styling" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Header, nav, footer, fonts" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Content -->
                <Label Text="Content" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnContentTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[P]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Pages and Content" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Choose pages, home layout" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnGalleryTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[G]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Photo Gallery" FontAttributes="Bold" FontSize="13"/>
                            <Label x:Name="GalleryCountLabel" Text="Manage photos (0 images)" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Print/Export -->
                <Label Text="Print and Export" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Frame BorderColor="#10B981" Padding="0" CornerRadius="8" BackgroundColor="#ECFDF5">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnFixturesSheetTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[F]" FontSize="16" VerticalOptions="Center" TextColor="#10B981"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Fixtures Sheet" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Printable fixtures grid" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- Advanced -->
                <Label Text="Advanced" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"/>

                <Frame BorderColor="#E5E7EB" Padding="0" CornerRadius="8">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSeoTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[S]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="SEO and Advanced" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Meta tags, custom CSS" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <Frame BorderColor="#3B82F6" Padding="0" CornerRadius="8" BackgroundColor="#EFF6FF">
                    <Grid Padding="12" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnDeploymentTapped"/></Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="[D]" FontSize="16" VerticalOptions="Center" TextColor="#3B82F6"/>
                        <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                            <Label Text="Deployment" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Export, GitHub Pages, FTP" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text=">" FontSize="20" TextColor="#9CA3AF" VerticalOptions="Center"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Divider line -->
        <BoxView Grid.Column="0" WidthRequest="1" BackgroundColor="#E5E7EB" HorizontalOptions="End"/>

        <!-- ═══ RIGHT PANEL: Live Preview ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="0">

            <!-- Preview toolbar -->
            <Grid BackgroundColor="#1E293B" Padding="12,8" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Live Preview" FontAttributes="Bold" FontSize="14"
                       TextColor="White" VerticalOptions="Center"/>
                <Picker Grid.Column="2" x:Name="PreviewPagePicker" Title="Page"
                        WidthRequest="140" SelectedIndexChanged="OnPreviewPageChanged"
                        TextColor="White" TitleColor="#94A3B8"/>
                <Button Grid.Column="3" x:Name="RefreshPreviewBtn" Text="&#128260; Refresh"
                        Clicked="OnPreviewClicked" BackgroundColor="#3B82F6" TextColor="White"
                        FontSize="11" Padding="10,6" CornerRadius="4"/>
            </Grid>

            <!-- Preview placeholder / WebView -->
            <Grid Grid.Row="1">
                <!-- Placeholder shown when no preview generated yet -->
                <VerticalStackLayout x:Name="PreviewPlaceholder"
                                     VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                    <Label Text="&#127760;" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="Click Preview to generate your website" FontSize="16"
                           FontAttributes="Bold" TextColor="#6B7280" HorizontalOptions="Center"/>
                    <Label Text="Your live preview will appear here" FontSize="13"
                           TextColor="#9CA3AF" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- The WebView (hidden initially) -->
                <WebView x:Name="PreviewWebView" IsVisible="False"
                         Navigating="OnPreviewNavigating"/>
            </Grid>
        </Grid>

    </Grid>

</ContentPage>
