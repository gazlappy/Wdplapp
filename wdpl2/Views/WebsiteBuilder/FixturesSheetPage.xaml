<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.FixturesSheetPage"
             Title="Fixtures Sheet">
    <Grid ColumnDefinitions="340,*" ColumnSpacing="0">
        <ScrollView Grid.Column="0" BackgroundColor="#F8FAFC">
            <VerticalStackLayout Padding="20,16" Spacing="12">
                <Label Text="Fixtures Sheet" FontSize="22" FontAttributes="Bold" TextColor="#1E293B"/>
                <Label Text="Classic paper-style printable fixture sheet" FontSize="12" TextColor="#64748B"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="&#x1F4BE; Save" Clicked="OnSaveClicked" BackgroundColor="#8B5CF6" FontSize="12" Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="1" Text="Preview" Clicked="OnPreviewClicked" BackgroundColor="#3B82F6" FontSize="12" Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="2" Text="Export" Clicked="OnExportClicked" BackgroundColor="#10B981" FontSize="12" Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="3" Text="Print" Clicked="OnPrintClicked" BackgroundColor="#64748B" FontSize="12" Padding="8,10" CornerRadius="8"/>
                </Grid>
                <Label x:Name="StatusLabel" FontSize="12" TextColor="#10B981" IsVisible="False"/>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Title" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                        <Entry x:Name="TitleEntry" Placeholder="e.g. WDPL 2025 League (auto-generated if blank)" FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Season" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                        <Picker x:Name="SeasonPicker" Title="Select Season"/>
                        <Label Text="Divisions:" FontSize="12" TextColor="#64748B"/>
                        <CollectionView x:Name="DivisionsCollection" SelectionMode="None" HeightRequest="100">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnDefinitions="32,*" ColumnSpacing="4">
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" FontSize="13"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Content" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <CheckBox x:Name="ShowTeamNumbersCheck" IsChecked="True" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Show team numbers" VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <CheckBox x:Name="ShowDivisionListsCheck" IsChecked="True" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Show division team lists" VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <CheckBox x:Name="ShowVenueInfoCheck" IsChecked="True" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Show venue info" VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <CheckBox x:Name="ShowSpecialEventsCheck" IsChecked="True" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Show key dates / events" VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <CheckBox x:Name="ShowFooterCheck" IsChecked="True" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Show footer notes" VerticalOptions="Center" FontSize="13"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Page" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                        <HorizontalStackLayout Spacing="16">
                            <RadioButton x:Name="LandscapeRadio" Content="Landscape" IsChecked="True" GroupName="orient"/>
                            <RadioButton x:Name="PortraitRadio" Content="Portrait" GroupName="orient"/>
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                        <Label Text="3D Card Tilt" FontAttributes="Bold" FontSize="12" TextColor="#64748B"/>
                        <Grid ColumnDefinitions="*,36" ColumnSpacing="6">
                            <Slider x:Name="TiltSlider" Minimum="0" Maximum="20" Value="8" VerticalOptions="Center"/>
                            <Label x:Name="TiltValueLabel" Grid.Column="1" Text="8°" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                        <Label Text="Logo" FontAttributes="Bold" FontSize="12" TextColor="#64748B"/>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <Label x:Name="LogoStatusLabel" Grid.Column="0" Text="No logo" FontSize="11" TextColor="#94A3B8" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="Upload" Clicked="OnUploadLogoClicked" BackgroundColor="#3B82F6" FontSize="11" Padding="10,6" CornerRadius="6"/>
                            <Button Grid.Column="2" Text="Clear" Clicked="OnClearLogoClicked" BackgroundColor="#EF4444" FontSize="11" Padding="10,6" CornerRadius="6"/>
                        </Grid>
                        <Label Text="Logo Size" FontSize="11" TextColor="#6B7280" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="*,40" ColumnSpacing="6">
                            <Slider x:Name="LogoSizeSlider" Minimum="24" Maximum="120" Value="48" VerticalOptions="Center"/>
                            <Label x:Name="LogoSizeValueLabel" Grid.Column="1" Text="48px" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                        </Grid>
                        <Label Text="Logo 3D Tilt" FontSize="11" TextColor="#6B7280"/>
                        <Grid ColumnDefinitions="*,36" ColumnSpacing="6">
                            <Slider x:Name="LogoTiltSlider" Minimum="0" Maximum="20" Value="0" VerticalOptions="Center"/>
                            <Label x:Name="LogoTiltValueLabel" Grid.Column="1" Text="0°" FontSize="11" TextColor="#64748B" VerticalOptions="Center"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Footer" FontAttributes="Bold" FontSize="13" TextColor="#1E293B"/>
                        <Entry x:Name="FooterNotesEntry" Placeholder="Footer notes (shown in red)" FontSize="12"/>
                        <Label Text="Extra Footer Notes" FontSize="11" TextColor="#6B7280"/>
                        <VerticalStackLayout x:Name="ExtraFooterNotesContainer" Spacing="4"/>
                        <Button Text="+ Add Footer Note" FontSize="11" BackgroundColor="#3B82F6" TextColor="White" CornerRadius="6" HeightRequest="34" Clicked="OnAddExtraFooterNoteClicked"/>
                        <Entry x:Name="WebsiteUrlEntry" Placeholder="Website URL" FontSize="12"/>
                        <Entry x:Name="EmailEntry" Placeholder="Email address" FontSize="12"/>
                        <Entry x:Name="ContactNameEntry" Placeholder="Match contact name" FontSize="12"/>
                        <Entry x:Name="ContactPhoneEntry" Placeholder="Match contact phone" FontSize="12"/>
                        <Entry x:Name="ReportNameEntry" Placeholder="Competition contact name" FontSize="12"/>
                        <Entry x:Name="ReportPhoneEntry" Placeholder="Competition contact phone" FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
                <Frame BorderColor="#E2E8F0" Padding="14" CornerRadius="10" BackgroundColor="White">
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <Label Text="Key Dates / Events" FontAttributes="Bold" FontSize="13" TextColor="#1E293B" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="&#x1F504; Sync Exclusion Dates" Clicked="OnSyncExclusionDatesClicked" BackgroundColor="#F59E0B" TextColor="White" FontSize="11" Padding="8,4" CornerRadius="6"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="6">
                            <Entry x:Name="EventDescEntry" Grid.Column="0" Placeholder="Description" FontSize="12"/>
                            <DatePicker x:Name="EventDatePicker" Grid.Column="1" FontSize="11"/>
                            <Button Grid.Column="2" Text="+" Clicked="OnAddEventClicked" BackgroundColor="#3B82F6" FontSize="14" Padding="8,4" CornerRadius="6" WidthRequest="36"/>
                        </Grid>
                        <CollectionView x:Name="EventsCollection" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4" ColumnDefinitions="80,*,Auto,30" ColumnSpacing="4">
                                        <Label Grid.Column="0" Text="{Binding DateDisplay}" FontSize="11" VerticalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding Description}" FontSize="11" VerticalOptions="Center"/>
                                        <Label Grid.Column="2" Text="{Binding SourceBadge}" FontSize="9" TextColor="#94A3B8" VerticalOptions="Center"/>
                                        <Button Grid.Column="3" Text="X" Clicked="OnRemoveEventClicked" BackgroundColor="Transparent" TextColor="#EF4444" FontSize="12" Padding="0"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Column="1" BackgroundColor="#E2E8F0" RowDefinitions="Auto,*">
            <Label Text="Preview" FontSize="12" TextColor="#64748B" Padding="16,8" FontAttributes="Bold"/>
            <WebView x:Name="PreviewWebView" Grid.Row="1" Margin="8,0,8,8"/>
        </Grid>
    </Grid>
</ContentPage>
