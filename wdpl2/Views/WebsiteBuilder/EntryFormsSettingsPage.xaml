<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.EntryFormsSettingsPage"
             Title="Entry Forms">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- Header -->
        <VerticalStackLayout Padding="20,16" Spacing="4" BackgroundColor="#F8FAFC">
            <Label Text="&#128203; Entry Forms" FontSize="22" FontAttributes="Bold" TextColor="#1E293B"/>
            <Label Text="Create entry forms for team registration, competitions, and more" FontSize="12" TextColor="#64748B" LineBreakMode="WordWrap"/>
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="0">

            <!-- LEFT: Form list -->
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0" BackgroundColor="#F8FAFC">

                <!-- Show on website toggle -->
                <Grid Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="Show on website" FontAttributes="Bold" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                    <Switch x:Name="ShowEntryFormsSwitch" Toggled="OnShowToggled" VerticalOptions="Center"/>
                </Grid>

                <!-- Add buttons -->
                <Grid Grid.Row="1" Padding="16,4,16,8" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Label Text="Forms" FontAttributes="Bold" FontSize="14" TextColor="#475569" VerticalOptions="Center"/>
                    <Button Grid.Column="1" x:Name="AddTeamEntryBtn" Text="+ Team Entry"
                            Clicked="OnAddTeamEntryClicked" BackgroundColor="#10B981" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                    <Button Grid.Column="2" x:Name="AddCompEntryBtn" Text="+ Competition"
                            Clicked="OnAddCompEntryClicked" BackgroundColor="#8B5CF6" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                    <Button Grid.Column="3" x:Name="AddCustomBtn" Text="+ Custom"
                            Clicked="OnAddCustomClicked" BackgroundColor="#3B82F6" TextColor="White"
                            FontSize="11" Padding="10,7" CornerRadius="8"/>
                </Grid>

                <!-- Form list -->
                <CollectionView Grid.Row="2" x:Name="FormsCollection"
                                SelectionMode="Single" SelectionChanged="OnFormSelected">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="12" Margin="8,4" CornerRadius="8"
                                   BorderColor="#E2E8F0" BackgroundColor="White" HasShadow="False">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Frame Padding="4,2" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                                               BackgroundColor="{Binding TypeBadgeColor}">
                                            <Label Text="{Binding TypeLabel}" FontSize="10" TextColor="White"/>
                                        </Frame>
                                        <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold"
                                               FontSize="13" TextColor="#1E293B" LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="2" Text="{Binding StatusIcon}" FontSize="14"/>
                                    </Grid>
                                    <Label Text="{Binding DateLabel}" FontSize="11" TextColor="#94A3B8"/>
                                    <Label Text="{Binding FieldCountLabel}" FontSize="11" TextColor="#64748B"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="20">
                            <Label Text="&#128203;" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="No entry forms yet" FontSize="14" FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                            <Label Text="Use the buttons above to create a team entry, competition entry, or custom form"
                                   FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Bottom actions -->
                <Grid Grid.Row="3" Padding="12" ColumnDefinitions="*,*" ColumnSpacing="8" BackgroundColor="White">
                    <Button x:Name="DeleteFormBtn" Text="&#128465; Delete" IsEnabled="False"
                            Clicked="OnDeleteFormClicked" BackgroundColor="#FEE2E2" TextColor="#DC2626"
                            FontSize="12" Padding="8,10" CornerRadius="8"/>
                    <Button Grid.Column="1" x:Name="DuplicateFormBtn" Text="&#128203; Duplicate" IsEnabled="False"
                            Clicked="OnDuplicateFormClicked" BackgroundColor="#EFF6FF" TextColor="#3B82F6"
                            FontSize="12" Padding="8,10" CornerRadius="8"/>
                </Grid>
            </Grid>

            <!-- Divider -->
            <BoxView Grid.Column="0" WidthRequest="1" BackgroundColor="#E2E8F0" HorizontalOptions="End"/>

            <!-- RIGHT: Editor -->
            <ScrollView Grid.Column="1">
                <VerticalStackLayout x:Name="EditorPanel" Padding="24,16" Spacing="16">

                    <!-- Placeholder when nothing selected -->
                    <VerticalStackLayout x:Name="EditorPlaceholder" VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Label Text="&#128203;" FontSize="48" HorizontalOptions="Center" Margin="0,60,0,0"/>
                        <Label Text="Select a form to edit" FontSize="16" FontAttributes="Bold" TextColor="#475569" HorizontalOptions="Center"/>
                        <Label Text="Or create a new one using the buttons on the left" FontSize="13"
                               TextColor="#94A3B8" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Editor form -->
                    <VerticalStackLayout x:Name="EditorForm" IsVisible="False" Spacing="16">

                        <!-- Form Details -->
                        <Label Text="FORM DETAILS" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>

                        <Frame BorderColor="#E2E8F0" Padding="16" CornerRadius="10" BackgroundColor="White">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Title" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Entry x:Name="TitleEntry" Placeholder="e.g. Season 2025 Team Entry" FontSize="14"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Description" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Editor x:Name="DescriptionEditor" Placeholder="Instructions for people filling in the form..."
                                            AutoSize="TextChanges" FontSize="14" HeightRequest="80"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Submit Button Text (website)" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Entry x:Name="SubmitButtonEntry" Placeholder="Submit Entry" FontSize="14"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Status -->
                        <Label Text="STATUS" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>

                        <Frame BorderColor="#E2E8F0" Padding="16" CornerRadius="10" BackgroundColor="White">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Published (visible on website)" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                    <Switch x:Name="IsPublishedSwitch"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Closed (no longer accepting entries)" FontSize="13" TextColor="#475569" VerticalOptions="Center"/>
                                    <Switch x:Name="IsClosedSwitch"/>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Closing Date (optional)" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <DatePicker x:Name="ClosingDatePicker" FontSize="14"/>
                                        <Button x:Name="ClearClosingDateBtn" Text="Clear" Clicked="OnClearClosingDate"
                                                BackgroundColor="Transparent" TextColor="#EF4444" FontSize="12"
                                                Padding="8,6" VerticalOptions="Center"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Fields -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="FORM FIELDS" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8"
                                   CharacterSpacing="1.5" VerticalOptions="Center"/>
                            <Button x:Name="AddFieldBtn" Text="+ Add Field" Clicked="OnAddFieldClicked"
                                    BackgroundColor="#3B82F6" TextColor="White" FontSize="11"
                                    Padding="10,7" CornerRadius="8"/>
                        </Grid>

                        <VerticalStackLayout x:Name="FieldsPanel" Spacing="8"/>

                        <VerticalStackLayout x:Name="NoFieldsLabel" IsVisible="False" Spacing="4" Padding="16">
                            <Label Text="No fields yet" FontSize="13" TextColor="#94A3B8" HorizontalOptions="Center"/>
                            <Label Text="Add fields to build your form" FontSize="12" TextColor="#CBD5E1" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Save button -->
                        <Button x:Name="SaveFormBtn" Text="&#128190; Save Form"
                                Clicked="OnSaveFormClicked"
                                BackgroundColor="#10B981" TextColor="White" FontSize="14"
                                Padding="16,12" CornerRadius="8" Margin="0,8,0,0"/>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,12,0,4"/>

                        <!-- ENTRIES section -->
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label x:Name="EntriesHeaderLabel" Text="ENTRIES (0)" FontSize="11" FontAttributes="Bold"
                                   TextColor="#94A3B8" CharacterSpacing="1.5" VerticalOptions="Center"/>
                            <Button Grid.Column="1" x:Name="AddEntryBtn" Text="+ Log Entry"
                                    Clicked="OnAddEntryClicked" BackgroundColor="#3B82F6" TextColor="White"
                                    FontSize="11" Padding="10,7" CornerRadius="8"/>
                            <Button Grid.Column="2" x:Name="DeleteEntryBtn" Text="&#128465;" IsEnabled="False"
                                    Clicked="OnDeleteEntryClicked" BackgroundColor="Transparent" TextColor="#EF4444"
                                    FontSize="14" Padding="6,4" WidthRequest="36" HeightRequest="36"/>
                        </Grid>

                        <CollectionView x:Name="EntriesCollection" SelectionMode="Single"
                                        SelectionChanged="OnEntrySelected" HeightRequest="180">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10" Margin="0,3" CornerRadius="8"
                                           BorderColor="#E2E8F0" BackgroundColor="White" HasShadow="False">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Frame Padding="5,3" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                                                   BackgroundColor="{Binding StatusColor}" VerticalOptions="Center">
                                                <Label Text="{Binding StatusLabel}" FontSize="10" TextColor="White"/>
                                            </Frame>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding EntryName}" FontSize="13" FontAttributes="Bold" TextColor="#1E293B"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding DateLabel}" FontSize="11" TextColor="#94A3B8"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding LinkedTeamLabel}" FontSize="11"
                                                   TextColor="#10B981" VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4" Padding="16">
                                    <Label Text="No entries logged yet" FontSize="12" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                    <Label Text="Use '+ Log Entry' to record entries as they come in" FontSize="11" TextColor="#CBD5E1" HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <!-- Entry detail panel -->
                        <Frame x:Name="EntryDetailPanel" IsVisible="False" BorderColor="#E2E8F0" Padding="14"
                               CornerRadius="10" BackgroundColor="#F8FAFC">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="ENTRY DETAILS" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Entry Name" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                        <Entry x:Name="EntryNameEntry" Placeholder="e.g. The Aces" FontSize="13"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Status" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                        <Picker x:Name="EntryStatusPicker" FontSize="13">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>pending</x:String>
                                                    <x:String>confirmed</x:String>
                                                    <x:String>rejected</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </VerticalStackLayout>
                                </Grid>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Link to Season Team" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Picker x:Name="EntryTeamPicker" FontSize="13" Title="-- None --"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Notes" FontSize="12" FontAttributes="Bold" TextColor="#475569"/>
                                    <Editor x:Name="EntryNotesEditor" Placeholder="Any notes about this entry..."
                                            AutoSize="TextChanges" FontSize="13" HeightRequest="50"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout x:Name="EntryFieldsPanel" Spacing="6"/>
                                <Button x:Name="SaveEntryBtn" Text="&#10003; Save Entry" Clicked="OnSaveEntryClicked"
                                        BackgroundColor="#3B82F6" TextColor="White" FontSize="12"
                                        Padding="12,8" CornerRadius="8" HorizontalOptions="Start"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,8,0,4"/>

                        <!-- TEAM CROSS-REFERENCE -->
                        <VerticalStackLayout x:Name="CrossRefSection" Spacing="8">
                            <Label Text="TEAM CROSS-REFERENCE" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" CharacterSpacing="1.5"/>
                            <Label x:Name="CrossRefSummaryLabel" Text="" FontSize="12" TextColor="#475569"/>
                            <CollectionView x:Name="CrossRefList" HeightRequest="200">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="8,5" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding StatusIcon}" FontSize="16" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding TeamName}" FontSize="13" TextColor="#1E293B" VerticalOptions="Center"/>
                                            <Label Grid.Column="2" Text="{Binding EntryLabel}" FontSize="11" TextColor="{Binding EntryLabelColor}" VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
