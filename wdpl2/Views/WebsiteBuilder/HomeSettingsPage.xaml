<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.HomeSettingsPage"
             Title="Home Page Settings">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Home Page Settings" FontSize="24" FontAttributes="Bold" TextColor="#3B82F6"/>
            <Label Text="Show or hide sections on the home page" FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap"/>

            <!-- Section Visibility -->
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Home Page Sections" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Toggle which sections appear on the home page" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,2"/>

                    <!-- Welcome / Hero -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#127968;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Welcome / Hero" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Season name, dates and welcome message" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowWelcomeSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Quick Stats -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128202;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Quick Stats" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Teams, players, matches played, divisions" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowQuickStatsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- League Leaders -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#127942;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="League Leaders" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Top rated players leaderboard" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowLeagueLeadersSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Recent Results -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#127937;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Recent Results" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Latest match results" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowRecentResultsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Upcoming Fixtures -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128197;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Upcoming Fixtures" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Next scheduled matches" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowUpcomingFixturesSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Latest News -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128240;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Latest News" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Recent news articles" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowLatestNewsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Sponsors -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="⭐" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Sponsors" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Sponsor logos on home page" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="ShowSponsorsSwitch" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Featured Pages -->
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Featured Pages" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="Show content from other pages on the home page" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>

                    <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0,2"/>

                    <!-- Standings -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#127942;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="League Standings" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Compact league table for the first division" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatStandingsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Entry Forms -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128203;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Entry Forms" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Display the current active entry form" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatEntryFormsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Competitions -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#127941;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Competitions" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Link card to cup draws and knockout brackets" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatCompetitionsSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Gallery -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128247;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Photo Gallery" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Link card to the photo gallery" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatGallerySwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Rules -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128214;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="League Rules" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Link card to the rules page" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatRulesSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Contact -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128231;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Contact Us" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Link card to the contact page" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatContactSwitch" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#F3F4F6"/>

                    <!-- Rows Reports -->
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                        <Label Text="&#128202;" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Rows Reports" FontAttributes="Bold" FontSize="13"/>
                            <Label Text="Link card to the rows reports page" FontSize="11" TextColor="#6B7280"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" x:Name="FeatRowsReportsSwitch" VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Item Counts -->
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Section Limits" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="How many items to show in each section" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap"/>

                    <Grid ColumnDefinitions="*,80" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Label Text="Recent Results" VerticalOptions="Center"/>
                        <Entry Grid.Column="1" x:Name="RecentResultsCountEntry" Placeholder="5" Keyboard="Numeric"/>

                        <Label Grid.Row="1" Text="Upcoming Fixtures" VerticalOptions="Center"/>
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="UpcomingFixturesCountEntry" Placeholder="5" Keyboard="Numeric"/>

                        <Label Grid.Row="2" Text="League Leaders" VerticalOptions="Center"/>
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="LeagueLeadersCountEntry" Placeholder="5" Keyboard="Numeric"/>

                        <Label Grid.Row="3" Text="Stats Columns" VerticalOptions="Center"/>
                        <Entry Grid.Row="3" Grid.Column="1" x:Name="StatsColumnsEntry" Placeholder="4" Keyboard="Numeric"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Button Text="Save Changes"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#10B981"
                    Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
