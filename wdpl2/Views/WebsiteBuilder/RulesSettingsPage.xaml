<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Wdpl2.Views.WebsiteBuilder.RulesSettingsPage"
             Title="League Rules">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="&#128214; League Rules" FontSize="24" FontAttributes="Bold" TextColor="#3B82F6"/>
            <Label Text="Rules are loaded from the built-in template files. Enable the toggle below to include a Rules page with tabbed sections and an auto-generated table of contents on your website." FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap"/>

            <!-- Enable toggle -->
            <Frame BorderColor="#E5E7EB" Padding="15" CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Show Rules Page" FontSize="14" FontAttributes="Bold"/>
                        <Label Text="Enable the Rules link in the website navigation" FontSize="12" TextColor="#6B7280"/>
                    </VerticalStackLayout>
                    <Switch x:Name="ShowRulesSwitch" Grid.Column="1" IsToggled="False"/>
                </Grid>
            </Frame>

            <!-- Constitution section -->
            <Frame BorderColor="#6366F1" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="&#128220; Constitution" FontSize="16" FontAttributes="Bold" TextColor="#4F46E5"/>
                    <Label x:Name="ConstitutionSubtitle" Text="Loading..." FontSize="12" TextColor="#6B7280"/>
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                    <Label Text="Table of Contents" FontSize="12" FontAttributes="Bold" TextColor="#4F46E5"/>
                    <VerticalStackLayout x:Name="ConstitutionToc" Spacing="2"/>
                </VerticalStackLayout>
            </Frame>

            <!-- League Match Rules section -->
            <Frame BorderColor="#059669" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="&#127942; League Match Rules" FontSize="16" FontAttributes="Bold" TextColor="#059669"/>
                    <Label x:Name="MatchRulesSubtitle" Text="Loading..." FontSize="12" TextColor="#6B7280"/>
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                    <Label Text="Table of Contents" FontSize="12" FontAttributes="Bold" TextColor="#059669"/>
                    <VerticalStackLayout x:Name="MatchRulesToc" Spacing="2"/>
                </VerticalStackLayout>
            </Frame>

            <!-- EPA Rules section -->
            <Frame BorderColor="#D97706" Padding="15" CornerRadius="8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="&#127993; EPA Rules" FontSize="16" FontAttributes="Bold" TextColor="#D97706"/>
                    <Label x:Name="EpaRulesSubtitle" Text="Loading..." FontSize="12" TextColor="#6B7280"/>
                    <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                    <Label Text="Table of Contents" FontSize="12" FontAttributes="Bold" TextColor="#D97706"/>
                    <VerticalStackLayout x:Name="EpaRulesToc" Spacing="2"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Save -->
            <Button x:Name="SaveBtn" Text="&#128190; Save Rules"
                    Clicked="OnSaveClicked"
                    BackgroundColor="#10B981" TextColor="White" FontSize="14"
                    Padding="20,12" CornerRadius="8" HorizontalOptions="Fill"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
