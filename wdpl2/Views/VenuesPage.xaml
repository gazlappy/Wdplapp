<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.VenuesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrls="clr-namespace:Wdpl2.Views.Controls"
    Title="Venues"
    SemanticProperties.Description="Venues management page">

    <Grid ColumnDefinitions="*,Auto,1.5*" RowDefinitions="Auto,*" Padding="12" ColumnSpacing="12" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
            <Label 
                Text="Manage Venues" 
                FontSize="20" 
                FontAttributes="Bold"
                VerticalOptions="Center"
                SemanticProperties.Description="Manage Venues" />
            <Label 
                x:Name="StatusLbl" 
                Grid.Column="1"
                Text="" 
                FontAttributes="Italic" 
                FontSize="12" 
                TextColor="#666" 
                VerticalOptions="Center"
                SemanticProperties.Description="Status message" />
        </Grid>

        <!-- Left: search + list -->
        <Border 
            Grid.Row="1" 
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Venues list panel">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Entry x:Name="SearchEntry" Placeholder="Search venues..." SemanticProperties.Description="Search venues" />

                <CollectionView 
                    x:Name="VenuesList" 
                    Grid.Row="1"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Always"
                    SemanticProperties.Description="Venues list">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Margin="0,0,0,4"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="2">
                                    <Label 
                                        Text="{Binding Name}" 
                                        FontSize="15" 
                                        FontAttributes="Bold"
                                        VerticalOptions="Center" />
                                    <Border
                                        Grid.Column="1"
                                        BackgroundColor="#3B82F6"
                                        StrokeThickness="0"
                                        Padding="8,2"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Center">
                                        <Label 
                                            Text="{Binding Tables.Count, StringFormat='{0} tables'}" 
                                            FontSize="11"
                                            TextColor="White" />
                                    </Border>
                                    <Label 
                                        Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Text="{Binding Address}" 
                                        FontSize="11"
                                        TextColor="#666"
                                        LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Middle: Venue Editor (always visible) -->
        <Border 
            Grid.Row="1" 
            Grid.Column="1"
            WidthRequest="320"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Venue editor panel">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label Text="⚙️ Venue Details" FontSize="16" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Venue Name" FontSize="12" />
                        <Entry x:Name="VenueNameEntry" SemanticProperties.Description="Venue name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Address" FontSize="12" />
                        <Entry x:Name="AddressEntry" SemanticProperties.Description="Venue address" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notes" FontSize="12" />
                        <Entry x:Name="NotesEntry" SemanticProperties.Description="Venue notes" />
                    </VerticalStackLayout>

                    <!-- Tables Section -->
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Tables" FontSize="14" FontAttributes="Bold" />

                    <Border
                        HeightRequest="150"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}">
                        <CollectionView x:Name="TablesList" VerticalScrollBarVisibility="Always" SemanticProperties.Description="Tables list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Label}" VerticalOptions="Center" FontSize="14" />
                                        <Label Grid.Column="1" Text="{Binding MaxTeams, StringFormat='Max: {0}'}" 
                                               FontSize="11" TextColor="#666"
                                               Margin="0,0,8,0" 
                                               VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Entry x:Name="NewTableEntry" Placeholder="New table name..." WidthRequest="180" Margin="0,0,6,6" SemanticProperties.Description="New table name" />
                        <Button x:Name="AddTableBtn" Text="+ Table" Margin="0,0,6,6" SemanticProperties.Description="Add table" />
                    </FlexLayout>

                    <Button x:Name="RemoveTableBtn" Text="Remove Selected Table" BackgroundColor="#EF4444" TextColor="White" SemanticProperties.Description="Remove selected table" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Actions" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="AddVenueBtn" Text="+ Add" Margin="0,0,6,6" SemanticProperties.Description="Add new venue" />
                        <Button x:Name="UpdateVenueBtn" Text="Update" Margin="0,0,6,6" SemanticProperties.Description="Update venue" />
                        <Button x:Name="DeleteVenueBtn" Text="Delete" BackgroundColor="#EF4444" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Delete venue" />
                    </FlexLayout>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="MultiSelectBtn" Text="☐ Multi-Select OFF" BackgroundColor="#6B7280" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Toggle multi-select mode" />
                        <Button x:Name="BulkDeleteBtn" Text="🗑️ Delete Selected" BackgroundColor="#DC2626" TextColor="White" IsVisible="False" Margin="0,0,6,6" SemanticProperties.Description="Delete selected venues" />
                    </FlexLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Data" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="SaveBtn" Text="💾 Save" Margin="0,0,6,6" SemanticProperties.Description="Save changes" />
                        <Button x:Name="ReloadBtn" Text="🔄 Reload" Margin="0,0,6,6" SemanticProperties.Description="Reload data" />
                        <Button x:Name="ExportBtn" Text="📤 Export" Margin="0,0,6,6" SemanticProperties.Description="Export venues to CSV" />
                    </FlexLayout>

                    <ctrls:CsvImportBox x:Name="VenuesImport" Title="Import Venues (.csv)" SemanticProperties.Description="Import venues from CSV" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Right: Venue Details Panel -->
        <Border 
            Grid.Row="1" 
            Grid.Column="2"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Venue details panel">
            <ScrollView>
                <VerticalStackLayout Spacing="12">

                    <!-- Empty State -->
                    <VerticalStackLayout 
                        x:Name="EmptyStatePanel"
                        Spacing="16"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="40"
                        IsVisible="True"
                        SemanticProperties.Description="No venue selected">
                        <Label 
                            Text="🏢"
                            FontSize="48"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="Select a venue"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#999"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="Click a venue from the list to view details, edit information, or manage tables"
                            FontSize="12"
                            TextColor="#999"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            MaximumWidthRequest="300" />
                    </VerticalStackLayout>

                    <!-- Venue Info Panel (initially hidden) -->
                    <VerticalStackLayout x:Name="VenueInfoPanel" IsVisible="False" Spacing="16" SemanticProperties.Description="Selected venue details">

                        <!-- Header with venue name -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="SelectedVenueName" FontSize="22" FontAttributes="Bold" />
                                <Label x:Name="SelectedVenueAddress" FontSize="12" TextColor="#666" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="1"
                                BackgroundColor="#3B82F6"
                                StrokeThickness="0"
                                Padding="12,6"
                                StrokeShape="RoundRectangle 16"
                                VerticalOptions="Start">
                                <Label 
                                    x:Name="SelectedVenueTableCount"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    TextColor="White" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                        <!-- Stats Cards -->
                        <Label Text="STATISTICS" FontSize="11" TextColor="#666" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                            <!-- Teams Card -->
                            <Border 
                                BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A5F}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="🏆" FontSize="24" />
                                    <Label x:Name="VenueTeamCount" FontSize="28" FontAttributes="Bold" TextColor="#3B82F6" />
                                    <Label Text="Teams" FontSize="11" TextColor="#666" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tables Card -->
                            <Border 
                                Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#14532D}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="🎱" FontSize="24" />
                                    <Label x:Name="VenueTableCountStat" FontSize="28" FontAttributes="Bold" TextColor="#16A34A" />
                                    <Label Text="Tables" FontSize="11" TextColor="#666" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Fixtures Card -->
                            <Border 
                                Grid.Row="1"
                                BackgroundColor="{AppThemeBinding Light=#FEF3C7, Dark=#713F12}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="📅" FontSize="24" />
                                    <Label x:Name="VenueFixtureCount" FontSize="28" FontAttributes="Bold" TextColor="#CA8A04" />
                                    <Label Text="Fixtures" FontSize="11" TextColor="#666" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Capacity Card -->
                            <Border 
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#FCE7F3, Dark=#831843}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="👥" FontSize="24" />
                                    <Label x:Name="VenueCapacity" FontSize="28" FontAttributes="Bold" TextColor="#DB2777" />
                                    <Label Text="Max Teams" FontSize="11" TextColor="#666" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                        <!-- Tables List -->
                        <Label Text="TABLES AT THIS VENUE" FontSize="11" TextColor="#666" FontAttributes="Bold" />
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                            HeightRequest="120">
                            <CollectionView x:Name="VenueTablesDisplay" VerticalScrollBarVisibility="Always" SemanticProperties.Description="Tables at this venue">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <Border
                                                BackgroundColor="#3B82F6"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18">
                                                <Label 
                                                    Text="🎱" 
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Label}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding MaxTeams, StringFormat='Max {0} teams'}" FontSize="11" TextColor="#666" />
                                            </VerticalStackLayout>
                                            <Label 
                                                Grid.Column="2" 
                                                Text="✓" 
                                                FontSize="18"
                                                TextColor="#16A34A"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="20" HorizontalOptions="Center">
                                        <Label Text="No tables defined" FontSize="11" TextColor="#666" HorizontalOptions="Center" />
                                        <Label Text="Use the editor to add tables" FontSize="11" TextColor="#666" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>

                        <!-- Teams at Venue -->
                        <Label Text="TEAMS AT THIS VENUE" FontSize="11" TextColor="#666" FontAttributes="Bold" Margin="0,8,0,0" />
                        <Border
                            StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                            HeightRequest="100">
                            <CollectionView x:Name="VenueTeamsDisplay" VerticalScrollBarVisibility="Always" SemanticProperties.Description="Teams at this venue">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="12,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border
                                                BackgroundColor="#6366F1"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18">
                                                <Label 
                                                    Text="🏆" 
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="No teams assigned to this venue" FontSize="11" TextColor="#666" Padding="20" HorizontalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>

                        <!-- Notes -->
                        <VerticalStackLayout x:Name="NotesSection" IsVisible="False" Spacing="4">
                            <Label Text="NOTES" FontSize="11" TextColor="#666" FontAttributes="Bold" />
                            <Border
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#2A2A2A}"
                                Padding="12">
                                <Label x:Name="SelectedVenueNotes" FontSize="12" TextColor="#666" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
