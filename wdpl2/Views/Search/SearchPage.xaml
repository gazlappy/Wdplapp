<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Search">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Search Bar -->
        <SearchBar
            x:Name="SearchInput"
            Placeholder="Search players, teams, venues..."
            SearchButtonPressed="OnSearch"
            TextChanged="OnSearchTextChanged" />

        <!-- Results -->
        <CollectionView x:Name="ResultsList" Grid.Row="1" SelectionMode="Single"
                        SelectionChanged="OnResultSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="🔍" FontSize="48" HorizontalTextAlignment="Center" />
                    <Label Text="Type to search across all data"
                           FontSize="15" HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666, Dark=#9CA3AF}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,10" Margin="0,0,0,6"
                            StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                            StrokeThickness="1">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <!-- Type badge -->
                            <Border Padding="8,4" VerticalOptions="Center"
                                    StrokeShape="RoundRectangle 6"
                                    BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#0C4A6E}"
                                    StrokeThickness="0">
                                <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}" />
                            </Border>
                            <!-- Details -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666, Dark=#9CA3AF}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
