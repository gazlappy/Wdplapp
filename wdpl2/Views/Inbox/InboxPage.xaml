<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Wdpl2.ViewModels.Inbox"
             xmlns:models="clr-namespace:Wdpl2.Services.Inbox"
             x:Class="Wdpl2.Views.Inbox.InboxPage"
             x:Name="PageRoot"
             Title="Web Inbox">
    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 10"
                Padding="14"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}">
            <VerticalStackLayout Spacing="8">
                <Label Text="wdpl.uk connection" FontAttributes="Bold" FontSize="14" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                    <Label Grid.Row="0" Grid.Column="0" Text="Base URL" VerticalOptions="Center" />
                    <Entry Grid.Row="0" Grid.Column="1" Text="{Binding BaseUrl}" Placeholder="https://wdpl.uk/api/" />
                    <Label Grid.Row="1" Grid.Column="0" Text="Admin user" VerticalOptions="Center" />
                    <Entry Grid.Row="1" Grid.Column="1" Text="{Binding AdminUser}" />
                    <Label Grid.Row="2" Grid.Column="0" Text="Password" VerticalOptions="Center" />
                    <Entry Grid.Row="2" Grid.Column="1" Text="{Binding AdminPassword}" IsPassword="True" />
                </Grid>
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Save settings" Command="{Binding SaveSettingsCommand}" />
                    <Button Text="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Text="Mark all processed"
                            Command="{Binding MarkAllProcessedCommand}"
                            IsVisible="{Binding HasItems}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <Label Grid.Row="1"
               Text="{Binding StatusMessage}"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#555, Dark=#9CA3AF}" />
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No pending submissions."
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666, Dark=#9CA3AF}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WebSubmission">
                        <Border StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Margin="0,0,0,8"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Summary}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding PayloadPretty}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       LineBreakMode="WordWrap" />
                                <Button Text="Mark processed"
                                        HorizontalOptions="Start"
                                        Command="{Binding BindingContext.MarkProcessedCommand, Source={x:Reference PageRoot}}"
                                        CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
