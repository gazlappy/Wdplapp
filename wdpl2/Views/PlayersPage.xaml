<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.PlayersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrls="clr-namespace:Wdpl2.Views.Controls"
    Title="Players"
    SemanticProperties.Description="Players management page">

    <Grid ColumnDefinitions="*,Auto,1.5*" RowDefinitions="Auto,*" Padding="12" ColumnSpacing="12" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
            <Label 
                Text="Manage Players" 
                FontSize="20" 
                FontAttributes="Bold"
                VerticalOptions="Center"
                SemanticProperties.Description="Manage Players" />
            <Label 
                x:Name="StatusLbl" 
                Grid.Column="1"
                Text="" 
                FontAttributes="Italic" 
                FontSize="12" 
                TextColor="#666" 
                VerticalOptions="Center"
                SemanticProperties.Description="Status message" />
        </Grid>

        <!-- Left: search + list -->
        <Border 
            Grid.Row="1" 
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Players list panel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Entry x:Name="SearchEntry" Placeholder="Search players..." SemanticProperties.Description="Search players" />

                <!-- Show All Seasons Toggle -->
                <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="4,0">
                    <CheckBox x:Name="ShowAllSeasonsCheck" SemanticProperties.Description="Show players from all seasons" />
                    <Label Text="Show all seasons" VerticalOptions="Center" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowAllSeasonsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <CollectionView 
                    x:Name="PlayersList" 
                    Grid.Row="2"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Always"
                    SemanticProperties.Description="Players list">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="8"
                                Margin="0,0,0,4"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                Opacity="{Binding Opacity}"
                                Stroke="Transparent"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 8">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A5F}" />
                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light=#3B82F6, Dark=#60A5FA}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                    <Border
                                        BackgroundColor="{Binding AvatarColor}"
                                        StrokeThickness="0"
                                        WidthRequest="32"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16">
                                        <Label
                                            Text="{Binding Initials}"
                                            TextColor="White"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                        <Label 
                                            Text="{Binding FullName}" 
                                            FontSize="14"
                                            TextDecorations="{Binding NameDecoration}" />
                                        <Label 
                                            Text="{Binding StatusLabel}" 
                                            FontSize="10" 
                                            TextColor="#F59E0B"
                                            IsVisible="{Binding ShowStatusLabel}" />
                                    </VerticalStackLayout>
                                    <Label 
                                        Grid.Column="2" 
                                        Text="{Binding DisplayTeamLabel}" 
                                        FontSize="12" 
                                        TextColor="{Binding TeamLabelColor}" 
                                        TextDecorations="Underline"
                                        VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPlayerTeamLabelTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Label 
                                        Grid.Column="3" 
                                        Text="{Binding TransferBadge}" 
                                        FontSize="10" 
                                        TextColor="#8B5CF6" 
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasTransfers}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Middle: Player Editor (always visible) -->
        <Border 
            Grid.Row="1" 
            Grid.Column="1"
            WidthRequest="320"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Player editor panel">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label Text="⚙️ Player Details" FontSize="16" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="First Name" FontSize="12" />
                        <Entry x:Name="FirstNameEntry" SemanticProperties.Description="Player first name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Last Name" FontSize="12" />
                        <Entry x:Name="LastNameEntry" SemanticProperties.Description="Player last name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Team" FontSize="12" />
                        <Picker x:Name="TeamPicker" ItemDisplayBinding="{Binding Name}" SemanticProperties.Description="Player team" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Notes" FontSize="12" />
                        <Entry x:Name="NotesEntry" SemanticProperties.Description="Player notes" />
                    </VerticalStackLayout>

                    <!-- Player Status -->
                    <Grid ColumnDefinitions="Auto,*" Padding="0,4,0,0">
                        <Label Text="Active Player" VerticalOptions="Center" FontSize="12" />
                        <Switch x:Name="IsActiveSwitch" Grid.Column="1" IsToggled="True" SemanticProperties.Description="Player is active" />
                    </Grid>

                    <Label x:Name="DeactivationInfoLabel" Text="" FontSize="11" TextColor="#F59E0B" IsVisible="False" />

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Actions" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="AddBtn" Text="+ Add" Margin="0,0,6,6" SemanticProperties.Description="Add new player" />
                        <Button x:Name="UpdateBtn" Text="Update" Margin="0,0,6,6" SemanticProperties.Description="Update player" />
                        <Button x:Name="DeleteBtn" Text="Delete" BackgroundColor="#EF4444" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Delete player" />
                    </FlexLayout>

                    <!-- Transfer Button -->
                    <Button 
                        x:Name="TransferBtn" 
                        Text="🔄 Transfer to Another Team" 
                        BackgroundColor="#8B5CF6" 
                        TextColor="White" 
                        IsEnabled="False"
                        SemanticProperties.Description="Transfer player to another team" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="MultiSelectBtn" Text="☐ Multi-Select OFF" BackgroundColor="#6B7280" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Toggle multi-select mode" />
                        <Button x:Name="BulkAssignTeamBtn" Text="📋 Assign Team" BackgroundColor="#3B82F6" TextColor="White" IsVisible="False" Margin="0,0,6,6" SemanticProperties.Description="Assign selected players to a team" />
                        <Button x:Name="BulkDeleteBtn" Text="🗑️ Delete Selected" BackgroundColor="#DC2626" TextColor="White" IsVisible="False" Margin="0,0,6,6" SemanticProperties.Description="Delete selected players" />
                    </FlexLayout>

                    <!-- Transfer History -->
                    <VerticalStackLayout x:Name="TransferHistorySection" IsVisible="False" Spacing="4">
                        <Label Text="Transfer History" FontSize="14" FontAttributes="Bold" Margin="0,8,0,0" />
                        <CollectionView x:Name="TransferHistoryList" HeightRequest="120">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8" Margin="0,2" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}" StrokeThickness="0" StrokeShape="RoundRectangle 4">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding TransferSummary}" FontSize="11" FontAttributes="Bold" />
                                            <Label Text="{Binding TransferDetails}" FontSize="10" TextColor="#666" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Data" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="SaveBtn" Text="💾 Save" Margin="0,0,6,6" SemanticProperties.Description="Save changes" />
                        <Button x:Name="ReloadBtn" Text="🔄 Reload" Margin="0,0,6,6" SemanticProperties.Description="Reload data" />
                        <Button x:Name="ExportBtn" Text="📤 Export" Margin="0,0,6,6" SemanticProperties.Description="Export players to CSV" />
                    </FlexLayout>

                    <ctrls:CsvImportBox x:Name="PlayersImport" Title="Import Players (.csv)" SemanticProperties.Description="Import players from CSV" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Right: Head-to-Head Results -->
        <Border 
            Grid.Row="1" 
            Grid.Column="2"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Player details and head-to-head panel">
            <ScrollView>
                <VerticalStackLayout Spacing="12">

                    <!-- Player Info Header -->
                    <VerticalStackLayout x:Name="PlayerInfoPanel" IsVisible="False" Spacing="4" SemanticProperties.Description="Selected player info">
                        <Label x:Name="SelectedPlayerName" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="SelectedPlayerTeam" FontSize="14" TextColor="#666" />
                        <Label x:Name="SelectedPlayerStats" FontSize="12" TextColor="#666" />
                    </VerticalStackLayout>

                    <!-- Filter Controls -->
                    <HorizontalStackLayout x:Name="FilterPanel" IsVisible="False" Spacing="8">
                        <Label Text="Season:" VerticalOptions="Center" FontSize="12" />
                        <Picker x:Name="H2HSeasonPicker" 
                                WidthRequest="150" 
                                FontSize="12"
                                ItemDisplayBinding="{Binding Name}"
                                SemanticProperties.Description="Filter by season" />
                    </HorizontalStackLayout>

                    <!-- Empty State -->
                    <VerticalStackLayout 
                        x:Name="EmptyStatePanel"
                        Spacing="12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="20"
                        SemanticProperties.Description="No player selected">
                        <Label 
                            Text="👈 Select a player"
                            FontSize="16"
                            TextColor="#999"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="View head-to-head results against opponents"
                            FontSize="12"
                            TextColor="#999"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Head-to-Head Results -->
                    <CollectionView 
                        x:Name="H2HList"
                        IsVisible="False"
                        SelectionMode="None"
                        SemanticProperties.Description="Head-to-head results">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                    StrokeShape="RoundRectangle 8">
                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">

                                        <!-- Opponent Name and Overall Record -->
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label 
                                                Text="{Binding OpponentName}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center" />
                                            <Border 
                                                Grid.Column="1"
                                                Padding="8,4"
                                                BackgroundColor="{Binding RecordColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4">
                                                <Label 
                                                    Text="{Binding RecordText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="White" />
                                            </Border>
                                        </Grid>

                                        <!-- Statistics -->
                                        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Frames" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding TotalFrames}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Win %" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding WinPercentage, StringFormat='{0:0}%'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                <Label Text="8-Balls" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding EightBalls}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Season Breakdown (if multiple seasons) -->
                                        <CollectionView 
                                            Grid.Row="2"
                                            ItemsSource="{Binding SeasonBreakdown}"
                                            IsVisible="{Binding HasMultipleSeasons}">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" Padding="8,4" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}">
                                                        <Label Text="{Binding SeasonName}" FontSize="11" TextColor="#666" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding Record}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
