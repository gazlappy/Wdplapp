<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.FixturesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Wdpl2.Views"
    xmlns:models="clr-namespace:Wdpl2.Models"
    Title="Fixtures"
    SemanticProperties.Description="Fixtures management page">

    <Grid ColumnDefinitions="300,*" RowDefinitions="Auto,*" Padding="4" ColumnSpacing="4" RowSpacing="4">
        
        <!-- OCR Progress Overlay -->
        <Border 
            x:Name="OcrProgressOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.ColumnSpan="2"
            IsVisible="False"
            BackgroundColor="#CC000000"
            ZIndex="200"
            Padding="20">
            <Border 
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}"
                StrokeShape="RoundRectangle 16"
                Padding="32"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="400">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label x:Name="OcrProgressTitle" 
                           Text="Processing Score Card" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           HorizontalTextAlignment="Center" />
                    
                    <ActivityIndicator 
                        x:Name="OcrActivityIndicator"
                        IsRunning="True"
                        Color="{StaticResource PrimaryColor}"
                        HeightRequest="48"
                        WidthRequest="48" />
                    
                    <Label x:Name="OcrProgressMessage" 
                           Text="Analyzing image with OCR..." 
                           FontSize="14" 
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                    
                    <ProgressBar x:Name="OcrProgressBar"
                                 Progress="0"
                                 ProgressColor="{StaticResource PrimaryColor}"
                                 HeightRequest="8" />
                    
                    <Label x:Name="OcrProgressPercent" 
                           Text="0%" 
                           FontSize="12" 
                           HorizontalTextAlignment="Center"
                           TextColor="Gray" />
                </VerticalStackLayout>
            </Border>
        </Border>
        
        <!-- Header with Burger Menu Button -->
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*">
            <Button 
                x:Name="BurgerMenuBtn"
                Text="☰"
                FontSize="20"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                Margin="0,0,8,0"
                BackgroundColor="{StaticResource PrimaryColor}"
                TextColor="White"
                SemanticProperties.Description="Open menu"
                SemanticProperties.Hint="Opens the fixtures controls menu" />
            
            <Label 
                Grid.Column="1"
                Text="Manage Fixtures" 
                Style="{StaticResource PageTitleStyle}"
                VerticalOptions="Center"
                SemanticProperties.Description="Manage Fixtures" />
        </Grid>

        <!-- Flyout Menu Overlay -->
        <Border 
            x:Name="FlyoutOverlay"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="100"
            SemanticProperties.Description="Menu overlay">
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="OverlayTap" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Flyout Menu Panel -->
        <Border 
            x:Name="FlyoutPanel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalOptions="Start"
            WidthRequest="350"
            IsVisible="False"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,12,12,0"
            Padding="12"
            ZIndex="101"
            SemanticProperties.Description="Fixtures controls menu">
            <ScrollView>
                <VerticalStackLayout Spacing="8">
                    
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="Controls" Style="{StaticResource SectionHeaderStyle}" VerticalOptions="Center" Margin="0" />
                        <Button 
                            x:Name="CloseFlyoutBtn"
                            Grid.Column="2"
                            Text="✕"
                            FontSize="16"
                            WidthRequest="36"
                            HeightRequest="36"
                            Padding="0"
                            Style="{StaticResource DangerButtonStyle}"
                            CornerRadius="18"
                            SemanticProperties.Description="Close menu" />
                    </Grid>
                    
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                    <Label Text="Filters" Style="{StaticResource SubsectionHeaderStyle}" Margin="0" FontSize="13" />

                    <Entry x:Name="SearchEntry" Placeholder="Search..." FontSize="13" SemanticProperties.Description="Search fixtures" />

                    <Picker x:Name="DivisionPicker" Title="All Divisions" ItemDisplayBinding="{Binding Name}" FontSize="13" SemanticProperties.Description="Filter by division" />

                    <DatePicker x:Name="FromDate" FontSize="13" SemanticProperties.Description="Filter from date" />

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Active season only" VerticalOptions="Center" FontSize="12" />
                        <Switch x:Name="ActiveSeasonOnly" Grid.Column="1" IsToggled="True" SemanticProperties.Description="Show active season only" />
                    </Grid>

                    <Border Padding="8" BackgroundColor="{AppThemeBinding Light=#F0F9FF, Dark=#1E3A8A}" StrokeShape="RoundRectangle 6">
                        <Label x:Name="PendingNotificationsLabel" Text="Loading..." FontSize="11" HorizontalTextAlignment="Center" SemanticProperties.Description="Pending notifications count" />
                    </Border>

                    <Label Text="Actions" Style="{StaticResource SubsectionHeaderStyle}" Margin="0,4,0,0" FontSize="13" />

                    <Button x:Name="ScanScoreCardBtn" Text="📷 Scan Score Card" BackgroundColor="{StaticResource PrimaryColor}" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Scan score card from photo" />
                    <Button x:Name="ManageNotificationsBtn" Text="🔔 Reminders" BackgroundColor="{StaticResource InfoColor}" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Manage reminders" />
                    <Button x:Name="PrintScorecardBtn" Text="🖨️ Print Scorecard" BackgroundColor="#059669" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Print blank scorecard" />
                    <Button x:Name="RescheduleBtn" Text="📅 Reschedule" BackgroundColor="#6366F1" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Reschedule fixture" />
                    <Button x:Name="BulkScoreBtn" Text="⚡ Bulk Score Entry" BackgroundColor="#7C3AED" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Bulk score entry mode" />
                    <Button x:Name="UndoSaveBtn" Text="↩️ Undo Last Save" BackgroundColor="#D97706" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="Undo last save" />
                    <Button x:Name="DiagnosticsBtn" Text="🔍 Diagnostics" BackgroundColor="{StaticResource Gray600}" TextColor="White" FontSize="12" HeightRequest="32" SemanticProperties.Description="View diagnostics" />
                    <Button x:Name="GenerateFixturesBtn" Text="Generate Fixtures" Style="{StaticResource SuccessButtonStyle}" FontSize="12" HeightRequest="32" SemanticProperties.Description="Generate fixtures" />
                    <Button x:Name="DeleteSeasonBtn" Text="Delete (Season)" Style="{StaticResource WarningButtonStyle}" FontSize="12" HeightRequest="32" SemanticProperties.Description="Delete season fixtures" />
                    <Button x:Name="DeleteAllBtn" Text="Delete ALL" Style="{StaticResource DangerButtonStyle}" FontSize="12" HeightRequest="32" SemanticProperties.Description="Delete all fixtures" />
                    
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- LEFT: Fixtures List -->
        <Border 
            Grid.Row="1"
            Grid.Column="0"
            StrokeShape="RoundRectangle 8" 
            Padding="8"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1"
            SemanticProperties.Description="Fixtures list panel">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Label Text="Fixtures" FontAttributes="Bold" FontSize="14" Margin="0" />
                
                <CollectionView
                    x:Name="FixturesList"
                    Grid.Row="1"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Always"
                    SemanticProperties.Description="Fixtures list">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:FixturesPage+FixtureListItem">
                            <Border
                                Padding="6"
                                Margin="0,0,0,3"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 6">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                    <Label 
                                        FontAttributes="Bold"
                                        FontSize="10"
                                        Text="{Binding Date, StringFormat='{0:ddd dd MMM}'}"
                                        VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label FontAttributes="Bold" FontSize="12" Text="{Binding Title}" LineBreakMode="TailTruncation" />
                                        <Label FontSize="10" TextColor="Gray" Text="{Binding Subtitle}" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding StatusIcon}" TextColor="{Binding StatusColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="3" Text="🔔" FontSize="12" VerticalOptions="Center" IsVisible="{Binding HasReminder}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No fixtures found" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Border>

        <!-- RIGHT: Scorecard Editor -->
        <Border 
            Grid.Row="1" 
            Grid.Column="1"
            StrokeShape="RoundRectangle 8" 
            Padding="0"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1"
            SemanticProperties.Description="Scorecard editor">

            <Grid RowDefinitions="Auto,Auto,*,Auto">

                <!-- Row 0: Match Header -->
                <Border BackgroundColor="#1E293B" Padding="14,10" StrokeThickness="0">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                        <Label x:Name="HomeTeamHeader" 
                               Text="Home Team" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Border Grid.Column="1" 
                                BackgroundColor="#334155" 
                                Padding="18,6" 
                                StrokeShape="RoundRectangle 10" 
                                StrokeThickness="0">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="1">
                                <Label x:Name="ScoreLbl" 
                                       Text="" 
                                       FontSize="26" 
                                       FontAttributes="Bold" 
                                       TextColor="#FFD700" 
                                       HorizontalTextAlignment="Center" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Label x:Name="DivisionLabel" 
                                           Text="Div." 
                                           FontSize="10" 
                                           TextColor="#94A3B8" />
                                    <Label x:Name="DateLabel" 
                                           Text="Date" 
                                           FontSize="10" 
                                           TextColor="#94A3B8" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Label x:Name="AwayTeamHeader" 
                               Grid.Column="2" 
                               Text="Away Team" 
                               FontSize="16" 
                               FontAttributes="Bold" 
                               TextColor="White"
                               HorizontalTextAlignment="Start"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </Border>

                <!-- Row 1: Phase / Frame Indicator -->
                <Border Grid.Row="1" 
                        Padding="10,5" 
                        BackgroundColor="{AppThemeBinding Light=#F0FDF4, Dark=#14532D}"
                        IsVisible="False"
                        x:Name="CurrentFrameIndicator"
                        StrokeThickness="0"
                        SemanticProperties.Description="Current frame indicator">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Start">
                            <Label Text="▶" FontSize="12" TextColor="{AppThemeBinding Light=#16A34A, Dark=#86EFAC}" VerticalOptions="Center" />
                            <Label x:Name="CurrentFrameLabel" 
                                   Text="Frame 1 - Select HOME player" 
                                   FontSize="13" 
                                   FontAttributes="Bold" 
                                   TextColor="{AppThemeBinding Light=#15803D, Dark=#86EFAC}" 
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Border x:Name="PhaseIndicator" 
                                Grid.Column="1"
                                IsVisible="False"
                                Padding="10,3"
                                BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Label x:Name="PhaseLabel" Text="" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Row 2: 3-column layout — Home Results | Player Pickers | Away Results -->
                <ScrollView Grid.Row="2">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6" Padding="4,0">

                        <!-- LEFT: Home scorecard -->
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="30,40,*" 
                                  BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" 
                                  Padding="4,6" ColumnSpacing="2">
                                <Label Text="#" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="H" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#16A34A, Dark=#86EFAC}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="Home Player" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout x:Name="HomeScorecardHost" Spacing="0" />
                        </VerticalStackLayout>

                        <!-- CENTER: Player Pickers -->
                        <Border Grid.Column="1" 
                                VerticalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" 
                                Padding="10,8"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                StrokeThickness="1">
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="3">
                                    <Label x:Name="HomeTeamListHeader" 
                                           Text="HOME PLAYERS" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#1E40AF, Dark=#93C5FD}"
                                           HorizontalTextAlignment="Center" />
                                    <VerticalStackLayout x:Name="HomePlayersQuickPanel" Spacing="2" />
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" WidthRequest="1" 
                                         BackgroundColor="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" 
                                         VerticalOptions="Fill" HorizontalOptions="Center" />
                                <VerticalStackLayout Grid.Column="2" Spacing="3">
                                    <Label x:Name="AwayTeamListHeader" 
                                           Text="AWAY PLAYERS" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="{AppThemeBinding Light=#991B1B, Dark=#FCA5A5}"
                                           HorizontalTextAlignment="Center" />
                                    <VerticalStackLayout x:Name="AwayPlayersQuickPanel" Spacing="2" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Away scorecard -->
                        <VerticalStackLayout Grid.Column="2" Spacing="0">
                            <Grid ColumnDefinitions="*,40,30" 
                                  BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#334155}" 
                                  Padding="4,6" ColumnSpacing="2">
                                <Label Text="Away Player" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF9A9A}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="A" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="8" FontAttributes="Bold" FontSize="11" TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout x:Name="AwayScorecardHost" Spacing="0" />
                        </VerticalStackLayout>

                    </Grid>
                </ScrollView>

                <!-- Row 3: Bottom Actions -->
                <Border Grid.Row="3" Padding="10,6" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E293B}" StrokeThickness="0">
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                        <!-- Late Card Controls -->
                        <Grid x:Name="LateCardPanel" IsVisible="False" 
                              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" 
                              ColumnSpacing="6">
                            <Label Text="⚠️" FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Late:" FontSize="11" FontAttributes="Bold" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" />
                            <Label Grid.Column="2" x:Name="HomeLateLabel" Text="Home" FontSize="10" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border Grid.Column="3" Padding="0" StrokeShape="RoundRectangle 4" 
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#475569}" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#334155}">
                                <HorizontalStackLayout Spacing="0">
                                    <Button x:Name="HomeLateMinusBtn" Text="−" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    <Label x:Name="HomeLatePenaltyLbl" Text="0" FontSize="12" FontAttributes="Bold"
                                           WidthRequest="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                                    <Button x:Name="HomeLatePlusBtn" Text="+" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="5" x:Name="AwayLateLabel" Text="Away" FontSize="10" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border Grid.Column="6" Padding="0" StrokeShape="RoundRectangle 4"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#475569}" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#334155}">
                                <HorizontalStackLayout Spacing="0">
                                    <Button x:Name="AwayLateMinusBtn" Text="−" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    <Label x:Name="AwayLatePenaltyLbl" Text="0" FontSize="12" FontAttributes="Bold"
                                           WidthRequest="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                                    <Button x:Name="AwayLatePlusBtn" Text="+" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="7" x:Name="LatePenaltySummary" Text="" FontSize="10" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                        </Grid>
                        <!-- Cancellation Controls -->
                        <Grid x:Name="CancelPanel" Grid.Row="1" IsVisible="False"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" 
                              ColumnSpacing="6">
                            <Label Text="🚫" FontSize="12" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Cancelled by:" FontSize="11" FontAttributes="Bold" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#7F1D1D, Dark=#FCA5A5}" />
                            <Button x:Name="CancelHomeBtn" Grid.Column="2" Text="Home" FontSize="11"
                                    HeightRequest="28" Padding="10,0" CornerRadius="4"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#475569}" 
                                    TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                            <Button x:Name="CancelAwayBtn" Grid.Column="3" Text="Away" FontSize="11"
                                    HeightRequest="28" Padding="10,0" CornerRadius="4"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#475569}" 
                                    TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                            <Label Grid.Column="4" Text="Pts:" FontSize="10" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Border Grid.Column="5" Padding="0" StrokeShape="RoundRectangle 4"
                                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#475569}" StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#334155}">
                                <HorizontalStackLayout Spacing="0">
                                    <Button x:Name="CancelPenaltyMinusBtn" Text="−" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                    <Label x:Name="CancelPenaltyLbl" Text="0" FontSize="12" FontAttributes="Bold"
                                           WidthRequest="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#1E293B, Dark=#F1F5F9}" />
                                    <Button x:Name="CancelPenaltyPlusBtn" Text="+" FontSize="14" FontAttributes="Bold"
                                            WidthRequest="28" HeightRequest="28" Padding="0" CornerRadius="4"
                                            BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="6" x:Name="CancelSummary" Text="" FontSize="10" 
                                   VerticalOptions="Center" TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                        </Grid>
                        <!-- Action Buttons -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                            <Label x:Name="HeaderLbl" Text="Select a fixture" FontSize="11" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" SemanticProperties.Description="Status" />

                            <!-- Hidden Entry for keyboard capture -->
                            <Entry x:Name="KeyboardCaptureEntry" 
                                   Grid.Column="1"
                                   WidthRequest="1" 
                                   HeightRequest="1"
                                   Opacity="0.01"
                                   Keyboard="Text"
                                   Placeholder=""
                                   SemanticProperties.Description="Keyboard input" />

                            <Label x:Name="ReminderStatusLabel" Grid.Column="2" Text="" FontSize="10" VerticalOptions="Center" TextColor="Gray" SemanticProperties.Description="Reminder status" />
                            <Button x:Name="CancelMatchBtn" Grid.Column="3" Text="🚫 Cancel" BackgroundColor="#991B1B" TextColor="White" HeightRequest="34" FontSize="12" Padding="14,0" CornerRadius="6" SemanticProperties.Description="Toggle cancellation panel" />
                            <Button x:Name="LateCardBtn" Grid.Column="4" Text="⚠️ Late" BackgroundColor="#D97706" TextColor="White" HeightRequest="34" FontSize="12" Padding="14,0" CornerRadius="6" SemanticProperties.Description="Toggle late card panel" />
                            <Button x:Name="ClearBtn" Grid.Column="5" Text="✕ Clear" BackgroundColor="#64748B" TextColor="White" HeightRequest="34" FontSize="12" Padding="14,0" CornerRadius="6" SemanticProperties.Description="Clear scorecard" />
                            <Button x:Name="SaveBtn" Grid.Column="6" Text="💾 Save" BackgroundColor="#16A34A" TextColor="White" HeightRequest="34" FontSize="12" FontAttributes="Bold" Padding="14,0" CornerRadius="6" SemanticProperties.Description="Save fixture" />
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</ContentPage>