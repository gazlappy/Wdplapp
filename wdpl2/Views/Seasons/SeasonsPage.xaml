<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.SeasonsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Wdpl2.Models"
    xmlns:vm="clr-namespace:Wdpl2.ViewModels"
    Title="Seasons"
    BackgroundColor="{AppThemeBinding Light=#F5F7F6, Dark=#111A17}"
    SemanticProperties.Description="Seasons management page">

    <Grid x:Name="PageLayout" ColumnDefinitions="*,*" RowDefinitions="Auto,*,Auto" Padding="20" ColumnSpacing="12" RowSpacing="16">
        
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="BackToLibraryBtn" Text="‹ Seasons" IsVisible="False"
                    Clicked="OnBackToLibraryClicked" VerticalOptions="Center"
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#16634B, Dark=#82DDB6}"
                    SemanticProperties.Description="Back to season library" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="PageHeading" Text="Seasons" FontSize="28" FontAttributes="Bold" Margin="0" />
                <Label x:Name="PageSubtitle" Text="Your league, season by season." FontSize="13" Margin="0"
                       TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="+ New season" Clicked="OnNewClicked"
                    BackgroundColor="#16634B" TextColor="White" VerticalOptions="Center"
                    SemanticProperties.Description="Create a new season" />
        </Grid>

        <!-- Flyout Menu Overlay -->
        <Border 
            x:Name="FlyoutOverlay"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            IsVisible="False"
            BackgroundColor="#80000000"
            ZIndex="100"
            SemanticProperties.Description="Menu overlay">
            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="OverlayTap" />
            </Border.GestureRecognizers>
        </Border>

        <!-- Flyout Menu Panel -->
        <Border 
            x:Name="FlyoutPanel"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            HorizontalOptions="Start"
            WidthRequest="400"
            IsVisible="False"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,12,12,0"
            Padding="{StaticResource LargePadding}"
            ZIndex="101"
            SemanticProperties.Description="Season controls menu">
            <ScrollView>
                <Grid
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{StaticResource MediumSpacing}"
                    RowSpacing="{StaticResource StandardSpacing}">

                    <HorizontalStackLayout Grid.ColumnSpan="2" Spacing="{StaticResource StandardSpacing}">
                        <Label Text="Edit season" Style="{StaticResource SectionHeaderStyle}" VerticalOptions="Center" Margin="0" />
                        <Button 
                            x:Name="CloseFlyoutBtn"
                            Text="✕"
                            FontSize="18"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            HorizontalOptions="EndAndExpand"
                            Style="{StaticResource DangerButtonStyle}"
                            CornerRadius="20"
                            SemanticProperties.Description="Close menu" />
                    </HorizontalStackLayout>
                    
                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" />

                    <Label Grid.Row="2" Grid.ColumnSpan="2" Text="Season Details" Style="{StaticResource SubsectionHeaderStyle}" Margin="0" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <Entry x:Name="NameEntry" Grid.Row="3" Grid.Column="1" Placeholder="e.g. Winter 2025" SemanticProperties.Description="Season name" />

                    <Label Grid.Row="4" Grid.Column="0" Text="Start date:" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <DatePicker x:Name="StartPicker" Grid.Row="4" Grid.Column="1" SemanticProperties.Description="Season start date" />

                    <Label Grid.Row="5" Grid.Column="0" Text="End date:" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <DatePicker x:Name="EndPicker" Grid.Row="5" Grid.Column="1" SemanticProperties.Description="Season end date" />

                    <Label Grid.Row="6" Grid.ColumnSpan="2" Text="Saving details will not change your working season."
                           Style="{StaticResource CaptionStyle}" />

                    <BoxView Grid.Row="7" Grid.ColumnSpan="2" HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" Margin="0,8,0,0" />

                    <Label Grid.Row="8" Grid.ColumnSpan="2" Text="Match Format" Style="{StaticResource SubsectionHeaderStyle}" Margin="0" />

                    <Label Grid.Row="9" Grid.Column="0" Text="Include Doubles:" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                    <Switch x:Name="DoublesSwitch" Grid.Row="9" Grid.Column="1" SemanticProperties.Description="Include doubles frames in matches" />

                    <Label x:Name="SinglesFramesLabel" Grid.Row="10" Grid.Column="0" Text="Singles Frames:" Style="{StaticResource FieldLabelStyle}" Margin="0" IsVisible="False"/>
                    <Entry x:Name="SinglesFramesEntry" Grid.Row="10" Grid.Column="1" Placeholder="e.g. 10" Keyboard="Numeric" IsVisible="False" SemanticProperties.Description="Number of singles frames" />

                    <Label x:Name="DoublesFramesLabel" Grid.Row="11" Grid.Column="0" Text="Doubles Frames:" Style="{StaticResource FieldLabelStyle}" Margin="0" IsVisible="False"/>
                    <Entry x:Name="DoublesFramesEntry" Grid.Row="11" Grid.Column="1" Placeholder="e.g. 5" Keyboard="Numeric" IsVisible="False" SemanticProperties.Description="Number of doubles frames" />

                    <Label Grid.Row="12" Grid.ColumnSpan="2" Text="Actions" Style="{StaticResource SubsectionHeaderStyle}" Margin="0,8,0,0" />

                    <HorizontalStackLayout Grid.Row="13" Grid.ColumnSpan="2" Spacing="{StaticResource StandardSpacing}">
                        <Button x:Name="SaveBtn" Text="Save" Clicked="OnSaveClicked" Style="{StaticResource PrimaryButtonStyle}" SemanticProperties.Description="Save season" />
                        <Button x:Name="DeleteBtn" Text="Delete" Clicked="OnDeleteClicked" Style="{StaticResource DangerButtonStyle}" SemanticProperties.Description="Delete season" />
                        <Button x:Name="LockBtn" Text="🔒 Lock" Clicked="OnLockToggleClicked" SemanticProperties.Description="Lock or unlock season" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Row="14" Grid.ColumnSpan="2" Spacing="{StaticResource StandardSpacing}">
                        <Button x:Name="GenerateBtn" Text="Generate Fixtures" Clicked="OnGenerateClicked" SemanticProperties.Description="Generate fixtures" />
                    </HorizontalStackLayout>

                    <Button x:Name="ImportHistoricalBtn" 
                            Grid.Row="15"
                            Grid.ColumnSpan="2"
                            Text="📋 Import from Previous Seasons" 
                            Clicked="OnImportHistoricalClicked"
                            BackgroundColor="{StaticResource WarningColor}"
                            TextColor="White"
                            SemanticProperties.Description="Import from previous seasons" />
                    
                    <Button x:Name="FixDataBtn" 
                            Grid.Row="16"
                            Grid.ColumnSpan="2"
                            Text="🔧 Fix Missing Season IDs" 
                            Clicked="OnFixMissingSeasonIdsClicked"
                            BackgroundColor="#FF6B00"
                            TextColor="White"
                            SemanticProperties.Description="Fix missing season IDs" />

                    <BoxView Grid.Row="18" Grid.ColumnSpan="2" HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}" 
                             Margin="0,12" />

                    <VerticalStackLayout Grid.Row="19" Grid.ColumnSpan="2" Spacing="{StaticResource StandardSpacing}">
                        <Label Text="Exclusion Dates" Style="{StaticResource SubsectionHeaderStyle}" Margin="0" />
                        
                        <Label Text="Dates when matches should not be scheduled:" 
                               Style="{StaticResource CaptionStyle}" />

                        <HorizontalStackLayout Spacing="{StaticResource StandardSpacing}">
                            <DatePicker x:Name="ExclusionDatePicker" 
                                       HorizontalOptions="FillAndExpand"
                                       SemanticProperties.Description="Exclusion date to add" />
                            <Entry x:Name="ExclusionTitleEntry"
                                   Placeholder="Title (e.g. Christmas Day)"
                                   HorizontalOptions="FillAndExpand"
                                   SemanticProperties.Description="Title for the exclusion date" />
                            <Button x:Name="AddExclusionBtn" 
                                   Text="+ Add" 
                                   Clicked="OnAddExclusionClicked"
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   SemanticProperties.Description="Add exclusion date" />
                        </HorizontalStackLayout>

                        <Border 
                            Style="{StaticResource CardBorderStyle}"
                            HeightRequest="120">
                            <CollectionView x:Name="ExclusionDatesList" SelectionMode="None" VerticalScrollBarVisibility="Always" SemanticProperties.Description="Exclusion dates list">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Type x:String}">
                                        <Border
                                            Padding="{StaticResource StandardPadding}"
                                            Margin="0,0,0,4"
                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource StandardSpacing}">
                                                <Label Text="{Binding}" 
                                                       VerticalOptions="Center"
                                                       FontSize="12" />
                                                <Button Grid.Column="1" 
                                                       Text="Edit" 
                                                       FontSize="11"
                                                       Padding="6,3"
                                                       Clicked="OnEditExclusionClicked"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource PrimaryButtonStyle}"
                                                       CornerRadius="4"
                                                       SemanticProperties.Description="Edit exclusion date" />
                                                <Button Grid.Column="2" 
                                                       Text="Remove" 
                                                       FontSize="11"
                                                       Padding="6,3"
                                                       Clicked="OnRemoveExclusionClicked"
                                                       CommandParameter="{Binding}"
                                                       Style="{StaticResource DangerButtonStyle}"
                                                       CornerRadius="4"
                                                       SemanticProperties.Description="Remove exclusion date" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="No exclusion dates" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </Border>

                    </VerticalStackLayout>
                    
                </Grid>
            </ScrollView>
        </Border>

        <Grid x:Name="LibraryPanel" Grid.Row="1" Grid.ColumnSpan="2"
              RowDefinitions="Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <SearchBar x:Name="SeasonSearch" Placeholder="Search seasons or years"
                           TextChanged="OnLibraryFilterChanged" SemanticProperties.Description="Search seasons" />
                <Picker x:Name="SeasonFilter" Grid.Column="1" Title="Filter" WidthRequest="110"
                        SelectedIndexChanged="OnLibraryFilterChanged" SemanticProperties.Description="Filter seasons">
                    <Picker.Items>
                        <x:String>All seasons</x:String>
                        <x:String>Current</x:String>
                        <x:String>Locked</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>
            <CollectionView x:Name="SeasonsList" Grid.Row="1" IsGrouped="True" SelectionMode="None"
                            SemanticProperties.Description="Season library. Open a season to preview it without switching.">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="SeasonCardsLayout" Orientation="Vertical" Span="2"
                                     HorizontalItemSpacing="14" VerticalItemSpacing="14" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,0,0,12">
                        <Border x:Name="CurrentSeasonCard" Padding="20" Stroke="#398567" StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#E6F3EC, Dark=#19382B}" IsVisible="False">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="CURRENT WORKING SEASON" FontSize="11" FontAttributes="Bold" Margin="0"
                                       TextColor="{AppThemeBinding Light=#16634B, Dark=#82DDB6}" />
                                <Label x:Name="CurrentSeasonName" FontSize="22" FontAttributes="Bold" Margin="0" />
                                <Label x:Name="CurrentSeasonSummary" FontSize="13" Margin="0" />
                                <Button Text="Preview season →" Clicked="OnPreviewCurrentClicked" HorizontalOptions="Start"
                                        BackgroundColor="#16634B" TextColor="White" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label x:Name="LibraryCountLabel" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}" />
                            <Button Grid.Column="1" Text="Refresh" Clicked="OnRefreshListClicked"
                                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#16634B, Dark=#82DDB6}" />
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="vm:SeasonYearGroup">
                        <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" Margin="0,16,0,10" />
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeasonCard">
                        <Border Padding="18" StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light=#DCE5DF, Dark=#354B40}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2922}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSeasonCardTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Stroke" Value="#398567" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="8">
                                    <Border IsVisible="{Binding IsCurrent}" BackgroundColor="#16634B" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6" Padding="8,3">
                                        <Label Text="Current" TextColor="White" FontSize="11" Margin="0" />
                                    </Border>
                                    <Border IsVisible="{Binding IsLocked}" BackgroundColor="{AppThemeBinding Light=#EDF0EE, Dark=#354B40}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,3">
                                        <Label Text="Locked" FontSize="11" Margin="0" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" MaxLines="2" Margin="0" />
                                <Label Text="{Binding Dates}" FontSize="12" Margin="0"
                                       TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}" />
                                <Label Text="{Binding Summary}" FontSize="13" Margin="0" />
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="#398567"
                                             BackgroundColor="{AppThemeBinding Light=#E4EBE6, Dark=#354B40}"
                                             SemanticProperties.Description="{Binding ProgressText}" />
                                <Label Text="{Binding ProgressText}" FontSize="12" Margin="0"
                                       TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}" />
                                <Button Text="Preview season →" Clicked="OnPreviewSeasonClicked" CommandParameter="{Binding .}"
                                        BackgroundColor="{AppThemeBinding Light=#EDF5F0, Dark=#263F31}"
                                        TextColor="{AppThemeBinding Light=#16634B, Dark=#82DDB6}"
                                        SemanticProperties.Description="{Binding Name, StringFormat='Preview {0} without switching seasons'}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="No seasons to show" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Try another search or filter, or create your first season."
                               HorizontalTextAlignment="Center" />
                        <Button Text="+ New season" Clicked="OnNewClicked" BackgroundColor="#16634B" TextColor="White" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <Border 
            x:Name="PreviewPanel"
            Grid.Row="1" 
            Grid.ColumnSpan="2"
            IsVisible="False"
            MaximumWidthRequest="1000"
            StrokeShape="RoundRectangle 16" 
            Padding="20"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2922}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1"
            SemanticProperties.Description="Season details panel">
            <ScrollView>
                <VerticalStackLayout Spacing="{StaticResource MediumSpacing}">
                    
                    <!-- Empty State -->
                    <VerticalStackLayout 
                        x:Name="EmptyStatePanel"
                        Spacing="{StaticResource MediumSpacing}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="40"
                        IsVisible="True"
                        SemanticProperties.Description="No season selected">
                        <Label 
                            Text="📅"
                            FontSize="48"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="Select a season"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Gray600}"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="Click a season from the list to view details and statistics"
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Season Info Panel (initially hidden) -->
                    <VerticalStackLayout x:Name="SeasonInfoPanel" IsVisible="False" Spacing="16" SemanticProperties.Description="Selected season details">
                        
                        <!-- Header -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="SEASON PREVIEW" FontSize="11" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#16634B, Dark=#82DDB6}" />
                            <Label x:Name="SelectedSeasonName" 
                                   Style="{StaticResource PageTitleStyle}" 
                                   Margin="0" />
                            <Label x:Name="SelectedSeasonDates" 
                                   Style="{StaticResource BodyTextStyle}"
                                   TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}" />
                            <Border x:Name="SelectedSeasonStatusBadge"
                                    Style="{StaticResource SuccessBadgeStyle}"
                                    HorizontalOptions="Start"
                                    Margin="0,4,0,0">
                                <Label x:Name="SelectedSeasonStatus" 
                                       Style="{StaticResource BadgeTextStyle}" />
                            </Border>
                            <Label x:Name="PreviewHintLabel" FontSize="13" Margin="0,8,0,0" />
                            <Button x:Name="SetActiveBtn" Text="Use this season" Clicked="OnSetActiveClicked"
                                    BackgroundColor="#16634B" TextColor="White" Margin="0,8,0,0"
                                    SemanticProperties.Description="Switch the whole app to this season" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                        <!-- Statistics Grid -->
                        <Label Text="Statistics" 
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,8,0,8" />

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" 
                              ColumnSpacing="12" RowSpacing="12">
                            
                            <!-- Divisions Card -->
                            <Border Grid.Column="0" Grid.Row="0"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="DivisionsCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryColor}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Divisions" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Teams Card -->
                            <Border Grid.Column="1" Grid.Row="0"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="TeamsCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource InfoColor}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Teams" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Players Card -->
                            <Border Grid.Column="0" Grid.Row="1"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="PlayersCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource SuccessColor}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Players" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Fixtures Card -->
                            <Border Grid.Column="1" Grid.Row="1"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="FixturesCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource WarningColor}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Fixtures" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Venues Card -->
                            <Border Grid.Column="0" Grid.Row="2"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="VenuesCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#8B5CF6"
                                           HorizontalOptions="Center" />
                                    <Label Text="Venues" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Competitions Card -->
                            <Border Grid.Column="1" Grid.Row="2"
                                    Style="{StaticResource CardBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}">
                                <VerticalStackLayout Padding="8" Spacing="2">
                                    <Label x:Name="CompetitionsCount" 
                                           Text="0"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="#EC4899"
                                           HorizontalOptions="Center" />
                                    <Label Text="Competitions" 
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,8" />

                        <!-- Quick Actions -->
                        <Label Text="Quick Actions" 
                               Style="{StaticResource SectionHeaderStyle}"
                               Margin="0,0,0,8" />

                        <Button x:Name="LockInfoBtn" 
                                Text="🔒 Lock Season"
                                Clicked="OnLockToggleClicked"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="Lock or unlock season" />

                        <Label x:Name="LockStatusLabel" 
                               Text="" 
                               FontSize="12"
                               IsVisible="False"
                               HorizontalOptions="Fill" />

                        <Button Text="Edit Season Details"
                                Clicked="OnBurgerMenuClicked"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="Edit season details" />

                        <Button x:Name="GeneratePreviewBtn" Text="Generate Fixtures"
                                Clicked="OnGenerateClicked"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="Generate fixtures for season" />

                        <Button x:Name="ExportSqlBtn"
                                Text="💾 Export Season SQL"
                                Clicked="OnExportSqlClicked"
                                BackgroundColor="#6366F1"
                                TextColor="White"
                                HorizontalOptions="Fill"
                                SemanticProperties.Description="Export entire season data as SQL script" />

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
        <Label x:Name="StatusLabel" Grid.Row="2" Grid.ColumnSpan="2" FontSize="12"
               TextColor="{AppThemeBinding Light=#52665D, Dark=#ABC1B6}"
               SemanticProperties.Description="Season status message" />
    </Grid>
</ContentPage>
