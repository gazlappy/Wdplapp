<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.TeamsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ctrls="clr-namespace:Wdpl2.Views.Controls"
    Title="Teams"
    SemanticProperties.Description="Teams management page">

    <Grid>
    <Grid ColumnDefinitions="*,Auto,1.5*" RowDefinitions="Auto,*" Padding="12" ColumnSpacing="12" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,Auto">
            <Label 
                Text="Manage Teams" 
                FontSize="20" 
                FontAttributes="Bold"
                VerticalOptions="Center"
                SemanticProperties.Description="Manage Teams" />
            <Label 
                x:Name="StatusLbl" 
                Grid.Column="1"
                Text="" 
                FontAttributes="Italic" 
                FontSize="12" 
                TextColor="#666" 
                VerticalOptions="Center"
                SemanticProperties.Description="Status message" />
        </Grid>

        <!-- Left: search + list -->
        <Border 
            Grid.Row="1" 
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Teams list panel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Entry x:Name="SearchEntry" Placeholder="Search teams..." SemanticProperties.Description="Search teams" />

                <!-- SHOW ALL SEASONS -->
                <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="4,0">
                    <CheckBox x:Name="ShowAllSeasonsCheck" SemanticProperties.Description="Show teams from all seasons" />
                    <Label Text="Show all seasons" VerticalOptions="Center" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowAllSeasonsTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <CollectionView 
                    x:Name="TeamsList" 
                    Grid.Row="2"
                    SelectionMode="Single"
                    VerticalScrollBarVisibility="Always"
                    SemanticProperties.Description="Teams list">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                               Padding="8"
                               Margin="0,0,0,4"
                               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                               Stroke="Transparent"
                               StrokeThickness="2"
                               StrokeShape="RoundRectangle 8">
                               <VisualStateManager.VisualStateGroups>
                                   <VisualStateGroupList>
                                       <VisualStateGroup x:Name="CommonStates">
                                           <VisualState x:Name="Normal" />
                                           <VisualState x:Name="Selected">
                                               <VisualState.Setters>
                                                   <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A5F}" />
                                                   <Setter Property="Stroke" Value="{AppThemeBinding Light=#3B82F6, Dark=#60A5FA}" />
                                               </VisualState.Setters>
                                           </VisualState>
                                       </VisualStateGroup>
                                   </VisualStateGroupList>
                               </VisualStateManager.VisualStateGroups>
                               <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                   <Label 
                                       Text="{Binding Name}" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                   <Label 
                                       Grid.Column="1" 
                                       FontSize="12" 
                                       TextColor="#666"
                                       VerticalOptions="Center">
                                        <Label.Text>
                                            <MultiBinding StringFormat="{}{0} • {1}">
                                                <Binding Path="VenueName" />
                                                <Binding Path="TableLabel" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- Middle: Team Editor (always visible) -->
        <Border 
            Grid.Row="1" 
            Grid.Column="1"
            WidthRequest="320"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Team editor panel">
            <ScrollView>
                <VerticalStackLayout Spacing="10">

                    <Label Text="⚙️ Team Details" FontSize="16" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Team Name" FontSize="12" />
                        <Entry x:Name="TeamNameEntry" SemanticProperties.Description="Team name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Division" FontSize="12" />
                        <Picker x:Name="DivisionPicker" ItemDisplayBinding="{Binding Name}" SemanticProperties.Description="Team division" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Venue" FontSize="12" />
                        <Picker x:Name="VenuePicker" ItemDisplayBinding="{Binding Name}" SemanticProperties.Description="Team venue" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Table" FontSize="12" />
                        <Picker x:Name="TablePicker" ItemDisplayBinding="{Binding Label}" SemanticProperties.Description="Team table" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Captain (Player)" FontSize="12" />
                        <Picker x:Name="CaptainPicker" ItemDisplayBinding="{Binding FullName}" SemanticProperties.Description="Team captain" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*" Padding="0,4,0,0">
                        <Label Text="Serves Food" VerticalOptions="Center" FontSize="12" />
                        <Switch x:Name="FoodSwitch" Grid.Column="1" SemanticProperties.Description="Team provides food" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Actions" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="AddBtn" Text="+ Add" Margin="0,0,6,6" SemanticProperties.Description="Add new team" />
                        <Button x:Name="UpdateBtn" Text="Update" Margin="0,0,6,6" SemanticProperties.Description="Update team" />
                        <Button x:Name="DeleteBtn" Text="Delete" BackgroundColor="#EF4444" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Delete team" />
                    </FlexLayout>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="MultiSelectBtn" Text="☐ Multi-Select OFF" BackgroundColor="#6B7280" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Toggle multi-select mode" />
                        <Button x:Name="BulkAssignDivisionBtn" Text="📋 Assign Division" BackgroundColor="#3B82F6" TextColor="White" IsVisible="False" Margin="0,0,6,6" SemanticProperties.Description="Assign selected teams to a division" />
                        <Button x:Name="BulkDeleteBtn" Text="🗑️ Delete Selected" BackgroundColor="#DC2626" TextColor="White" IsVisible="False" Margin="0,0,6,6" SemanticProperties.Description="Delete selected teams" />
                        <Button x:Name="RandomDivisionBtn" Text="🎲 Random Division Assign" BackgroundColor="#8B5CF6" TextColor="White" Margin="0,0,6,6" SemanticProperties.Description="Randomly assign teams to divisions evenly" />
                    </FlexLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" />

                    <Label Text="Data" FontSize="14" FontAttributes="Bold" />

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Direction="Row">
                        <Button x:Name="SaveBtn" Text="💾 Save" Margin="0,0,6,6" SemanticProperties.Description="Save changes" />
                        <Button x:Name="ReloadBtn" Text="🔄 Reload" Margin="0,0,6,6" SemanticProperties.Description="Reload data" />
                        <Button x:Name="ExportBtn" Text="📤 Export" Margin="0,0,6,6" SemanticProperties.Description="Export teams to CSV" />
                    </FlexLayout>

                    <ctrls:CsvImportBox x:Name="TeamsImport" Title="Import Teams (.csv)" SemanticProperties.Description="Import teams from CSV" />

                    <Button x:Name="DebugCheckBtn" Text="🔍 Check DB" BackgroundColor="#FF6B00" TextColor="White" SemanticProperties.Description="Check database integrity" />

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Right: Head-to-Head Match Results + Team Players -->
        <Border 
            Grid.Row="1" 
            Grid.Column="2"
            StrokeShape="RoundRectangle 12" 
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
            StrokeThickness="1"
            SemanticProperties.Description="Team details and head-to-head panel">
            <ScrollView>
                <VerticalStackLayout Spacing="12">
                
                    <!-- Team Info Header -->
                    <VerticalStackLayout x:Name="TeamInfoPanel" IsVisible="False" Spacing="4" SemanticProperties.Description="Selected team info">
                        <Label x:Name="SelectedTeamName" FontSize="18" FontAttributes="Bold" />
                        <Label x:Name="SelectedTeamDivision" FontSize="14" TextColor="#666" />
                        <Label x:Name="SelectedTeamStats" FontSize="12" TextColor="#666" />
                    </VerticalStackLayout>

                    <!-- Filter Controls -->
                    <HorizontalStackLayout x:Name="FilterPanel" IsVisible="False" Spacing="8">
                        <Label Text="Season:" VerticalOptions="Center" FontSize="12" />
                        <Picker x:Name="H2HSeasonPicker" 
                                WidthRequest="150" 
                                FontSize="12"
                                ItemDisplayBinding="{Binding Name}"
                                SemanticProperties.Description="Filter by season" />
                    </HorizontalStackLayout>

                    <!-- Empty State -->
                    <VerticalStackLayout 
                        x:Name="EmptyStatePanel"
                        Spacing="12"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="20"
                        SemanticProperties.Description="No team selected">
                        <Label 
                            Text="👈 Select a team"
                            FontSize="16"
                            TextColor="#999"
                            HorizontalOptions="Center" />
                        <Label 
                            Text="View head-to-head match results against opponents"
                            FontSize="12"
                            TextColor="#999"
                            HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Head-to-Head Results Section -->
                    <VerticalStackLayout x:Name="H2HSection" IsVisible="False" Spacing="8">
                        <Label Text="📊 Head-to-Head Results" FontSize="16" FontAttributes="Bold" />
                        
                        <CollectionView 
                            x:Name="H2HList"
                            SelectionMode="None"
                            SemanticProperties.Description="Head-to-head results">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                        StrokeShape="RoundRectangle 8">
                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                            
                                            <!-- Opponent Name and Overall Record -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label 
                                                    Text="{Binding OpponentName}"
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    VerticalOptions="Center" />
                                                <Border 
                                                    Grid.Column="1"
                                                    Padding="8,4"
                                                    BackgroundColor="{Binding RecordColor}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 4">
                                                    <Label 
                                                        Text="{Binding RecordText}"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="White" />
                                                </Border>
                                            </Grid>

                                            <!-- Statistics -->
                                            <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="Matches" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                    <Label Text="{Binding TotalMatches}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                    <Label Text="Win %" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                    <Label Text="{Binding WinPercentage, StringFormat='{0:0}%'}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                    <Label Text="Frames" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                    <Label Text="{Binding FrameRecord}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="3" Spacing="2">
                                                    <Label Text="Points" FontSize="10" TextColor="#666" HorizontalOptions="Center" />
                                                    <Label Text="{Binding PointsRecord}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                                </VerticalStackLayout>
                                            </Grid>

                                            <!-- Season Breakdown (if multiple seasons) -->
                                            <CollectionView 
                                                Grid.Row="2"
                                                ItemsSource="{Binding SeasonBreakdown}"
                                                IsVisible="{Binding HasMultipleSeasons}">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2" Padding="8,4" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}">
                                                            <Label Text="{Binding SeasonName}" FontSize="11" TextColor="#666" VerticalOptions="Center" />
                                                            <Label Grid.Column="1" Text="{Binding MatchRecord}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" />
                                                            <Label Grid.Column="2" Text="{Binding FrameRecord}" FontSize="10" TextColor="#666" VerticalOptions="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Team Players Section -->
                    <VerticalStackLayout x:Name="TeamPlayersSection" IsVisible="False" Spacing="8">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,8" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="👥 Team Players" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label x:Name="TeamPlayersCountLabel" Grid.Column="1" FontSize="12" TextColor="#666" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView 
                            x:Name="TeamPlayersList"
                            SelectionMode="None"
                            SemanticProperties.Description="Team players list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                        StrokeShape="RoundRectangle 6">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">

                                            <!-- Position/Rank -->
                                            <Border 
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                BackgroundColor="{Binding RankColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14">
                                                <Label 
                                                    Text="{Binding RankDisplay}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <!-- Player Name -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label 
                                                    Text="{Binding PlayerName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation" />
                                                <Label 
                                                    Text="{Binding CaptainLabel}"
                                                    FontSize="10"
                                                    TextColor="#F59E0B"
                                                    IsVisible="{Binding IsCaptain}" />
                                            </VerticalStackLayout>

                                            <!-- Played -->
                                            <VerticalStackLayout Grid.Column="2" Spacing="2" WidthRequest="45">
                                                <Label Text="Played" FontSize="9" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding Played}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                                            </VerticalStackLayout>

                                            <!-- Win % -->
                                            <VerticalStackLayout Grid.Column="3" Spacing="2" WidthRequest="45">
                                                <Label Text="Win%" FontSize="9" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding WinPercentageDisplay}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{Binding WinPercentageColor}" />
                                            </VerticalStackLayout>

                                            <!-- Rating -->
                                            <VerticalStackLayout Grid.Column="4" Spacing="2" WidthRequest="50">
                                                <Label Text="Rating" FontSize="9" TextColor="#666" HorizontalOptions="Center" />
                                                <Label Text="{Binding Rating}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" />
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Team Fixtures Section -->
                    <VerticalStackLayout x:Name="TeamFixturesSection" IsVisible="False" Spacing="8">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" Margin="0,8" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="📅 Fixtures" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label x:Name="TeamFixturesCountLabel" Grid.Column="1" FontSize="12" TextColor="#666" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView 
                            x:Name="TeamFixturesList"
                            SelectionMode="None"
                            SemanticProperties.Description="Team fixtures list">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,4"
                                        Padding="10,8"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2A2A2A}"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                        StrokeShape="RoundRectangle 6">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">

                                            <!-- Home/Away badge -->
                                            <Border 
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                BackgroundColor="{Binding HomeAwayColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 13">
                                                <Label 
                                                    Text="{Binding HomeAwayText}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                            </Border>

                                            <!-- Date -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" WidthRequest="70">
                                                <Label 
                                                    Text="{Binding DateText}"
                                                    FontSize="12"
                                                    FontAttributes="Bold" />
                                                <Label 
                                                    Text="{Binding VenueName}"
                                                    FontSize="9"
                                                    TextColor="#999"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1" />
                                            </VerticalStackLayout>

                                            <!-- Opponent -->
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                                <Label 
                                                    Text="{Binding OpponentName}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    LineBreakMode="TailTruncation" />
                                                <Label 
                                                    Text="{Binding DivisionName}"
                                                    FontSize="9"
                                                    TextColor="#999" />
                                            </VerticalStackLayout>

                                            <!-- Result -->
                                            <VerticalStackLayout Grid.Column="3" Spacing="2" WidthRequest="55">
                                                <Label 
                                                    Text="{Binding ResultText}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    HorizontalOptions="Center"
                                                    TextColor="{Binding ResultColor}" />
                                                <Label 
                                                    Text="{Binding ResultIcon}"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    HorizontalOptions="Center"
                                                    TextColor="{Binding ResultIconColor}" />
                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
    <ctrls:LoadingOverlay x:Name="LoadingOverlay" Message="Assigning divisions..."/>
    </Grid>
</ContentPage>
