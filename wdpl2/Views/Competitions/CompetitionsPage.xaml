<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Wdpl2.Views.CompetitionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Wdpl2.Models"
    xmlns:viewmodels="clr-namespace:Wdpl2.ViewModels"
    x:DataType="viewmodels:CompetitionsViewModel"
    Title="Competitions">

    <Grid x:Name="RootGrid" ColumnDefinitions="*,2*" Padding="12" ColumnSpacing="12">

        <!-- LEFT: Competitions List -->
        <Border
            Grid.Column="0"
            StrokeShape="RoundRectangle 12"
            Padding="12"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="8">

                <!-- Row 0: Title -->
                <Label Text="Competitions" FontSize="20" FontAttributes="Bold" />

                <!-- Row 1: Season -->
                <Label
                    Grid.Row="1"
                    x:Name="SeasonLabel"
                    FontSize="12"
                    TextColor="Gray" />

                <!-- Row 2: Active / History Toggle -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button
                        x:Name="ActiveTab"
                        Text="Active"
                        Clicked="OnShowActive"
                        BackgroundColor="#3B82F6"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="6,4" FontSize="13" />
                    <Button
                        x:Name="HistoryTab"
                        Grid.Column="1"
                        Text="History"
                        Clicked="OnShowHistory"
                        BackgroundColor="#6B7280"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="6,4" FontSize="13" />
                </Grid>

                <!-- Row 3: Competition List (fills remaining space) -->
                <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout x:Name="CompetitionsList" Spacing="4" />
                </ScrollView>

                <!-- Row 4: Action Buttons -->
                <HorizontalStackLayout Grid.Row="4" Spacing="8">
                    <Button
                        x:Name="NewBtn"
                        Text="+ New"
                        Clicked="OnNewCompetition"
                        HorizontalOptions="FillAndExpand" />
                    <Button
                        x:Name="DeleteBtn"
                        Text="Delete"
                        Clicked="OnDeleteCompetition"
                        BackgroundColor="#EF4444"
                        TextColor="White"
                        HorizontalOptions="FillAndExpand" />
                </HorizontalStackLayout>

                <!-- Row 5: Status -->
                <Label
                    Grid.Row="5"
                    x:Name="StatusLbl"
                    Text="{Binding StatusMessage}"
                    FontSize="11"
                    TextColor="Gray"
                    HorizontalTextAlignment="Center" />
            </Grid>
        </Border>

        <!-- RIGHT: Competition Details/Editor -->
        <Border
            Grid.Column="1"
            StrokeShape="RoundRectangle 12"
            Padding="8"
            BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#1A1A1A}"
            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
            StrokeThickness="1">
            <Grid x:Name="ContentPanel" />
        </Border>

    </Grid>
</ContentPage>
