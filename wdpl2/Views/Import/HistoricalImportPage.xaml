<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Wdpl2.Views.HistoricalImportPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:Wdpl2.Views"
 Title="Import" BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#141D19}">
 <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="16">
  <VerticalStackLayout Spacing="8">
   <Label Text="Import" FontSize="28" FontAttributes="Bold" />
   <Label Text="Bring your league history together." FontSize="14" />
   <Grid x:Name="StepIndicator" ColumnDefinitions="*,*,*">
    <HorizontalStackLayout Spacing="6"><Label x:Name="Step1Icon" Text="1" /><Label x:Name="Step1Label" Text="Choose" /></HorizontalStackLayout>
    <HorizontalStackLayout Grid.Column="1" Spacing="6"><Label x:Name="Step2Icon" Text="2" /><Label x:Name="Step2Label" Text="Review" /></HorizontalStackLayout>
    <HorizontalStackLayout Grid.Column="2" Spacing="6"><Label x:Name="Step3Icon" Text="3" /><Label x:Name="Step3Label" Text="Import" /></HorizontalStackLayout>
   </Grid>
  </VerticalStackLayout>
  <ScrollView Grid.Row="1">
   <VerticalStackLayout Spacing="16">
    <VerticalStackLayout x:Name="Step1Content" Spacing="20">
     <Border Padding="24" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=White, Dark=#22332A}">
      <VerticalStackLayout Spacing="16">
       <Label Text="One place for every import" FontSize="22" FontAttributes="Bold" />
       <Label Text="Choose files and the app selects the importer. You can also scan folders or open a complete Paradox database folder. Import competition history from Word or HTML." FontSize="14" />
       <Button x:Name="ImportEntryButton" Text="Import" Clicked="OnUnifiedImportClicked" BackgroundColor="#16634B" TextColor="White" FontSize="17" Padding="24,14" SemanticProperties.Description="Choose an import source" />
       <Label Text="Access · SQL · Paradox · Word · Excel · CSV · HTML · PDF" FontSize="13" />
      </VerticalStackLayout>
     </Border>
     <Label Text="Review before saving" FontAttributes="Bold" FontSize="17" />
     <Label Text="Files are checked before processing. Multiple HTML files share a batch preview; single files use their format-specific flow. Locked seasons are protected when saving." FontSize="14" />
     <Label Text="Up to 100 MB per file and 500 MB per selection. Legacy XLS files must be saved as XLSX or CSV. Access and legacy Word support depend on installed platform providers." FontSize="12" />
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="Step2Content" IsVisible="False" Spacing="12">
     <Label x:Name="Step2Title" Text="Review files" FontSize="22" FontAttributes="Bold" />
     <Label x:Name="Step2Description" Text="Check the detected format before continuing." />
     <VerticalStackLayout x:Name="FileSelectionArea" Spacing="12" />
     <Border x:Name="SelectedFilesPanel" IsVisible="False" Padding="12" StrokeShape="RoundRectangle 12">
      <CollectionView x:Name="SelectedFilesList" SelectionMode="None" HeightRequest="300">
       <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="local:SelectedFile">
         <Grid ColumnDefinitions="*,Auto" Padding="8" ColumnSpacing="8">
          <VerticalStackLayout Spacing="4">
           <Label Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
           <Label Text="{Binding FilePath}" FontSize="11" LineBreakMode="MiddleTruncation" />
          </VerticalStackLayout>
          <Button Grid.Column="1" Text="Remove" Clicked="OnRemoveFile" CommandParameter="{Binding .}" />
         </Grid>
        </DataTemplate>
       </CollectionView.ItemTemplate>
      </CollectionView>
     </Border>
    </VerticalStackLayout>
    <VerticalStackLayout x:Name="Step3Content" IsVisible="False" Spacing="16">
     <Label x:Name="Step3Title" Text="Processing" FontSize="22" FontAttributes="Bold" />
     <Border x:Name="ProgressPanel" IsVisible="False" Padding="20">
      <VerticalStackLayout Spacing="12">
       <ActivityIndicator IsRunning="True" Color="#16634B" />
       <Label x:Name="ProgressMessage" Text="Checking files..." HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
     </Border>
     <VerticalStackLayout x:Name="ResultsArea" Spacing="12" />
    </VerticalStackLayout>
   </VerticalStackLayout>
  </ScrollView>
  <VerticalStackLayout Grid.Row="2" Spacing="8">
   <Label x:Name="StatusLabel" Text="" FontSize="12" />
   <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
    <Button x:Name="BackButton" Text="Back" Clicked="OnBackClicked" IsVisible="False" />
    <Button x:Name="CancelButton" Grid.Column="1" Text="Cancel" Clicked="OnCancelClicked" IsVisible="False" />
    <Button x:Name="NextButton" Grid.Column="2" Text="Continue" Clicked="OnNextClicked" IsVisible="False" BackgroundColor="#16634B" TextColor="White" />
   </Grid>
  </VerticalStackLayout>
 </Grid>
</ContentPage>
